            "source": "JC4880P443_V1.0.pdf",
            "date": "2026-11-18",
            "result": "pending",
            "notes": "From the schematic: none of these was started on the board. din is ASDOUT of the ES8311, on the net ES7210_SDOUT."
        },
        "power": {
            "level": "schematic",
            "covers": ["power"],
            "source": "JC4880P443_V1.0.pdf, the archive JC4880P443C_I_W.zip of Guition",
            "date": "2026-11-18"
        }
    },
    "buses": {
        "dsi": {"dsi0": {"lanes": 2, "lane_mbps": 1000, "phy_ldo_chan": 3, "phy_ldo_mv": 2500}},
        "csi": {"csi0": {"lanes": 2, "phy_ldo_chan": 3, "phy_ldo_mv": 2500}},
        "i2c": {"i2c0": {"sda": 7, "scl": 8}},
        "i2s": {"i2s0": {"mclk": 13, "bclk": 12, "ws": 10, "dout": 9, "din": 48}},
        "sdio": {"sdio0": {"clk": 18, "cmd": 19, "d0": 14, "d1": 15, "d2": 16, "d3": 17, "reset": 54}},
        "uart": {"uart0": {"tx": 37, "rx": 38}, "uart1": {"tx": 26, "rx": 27}},
        "sdmmc": {"sdmmc0": {"clk": 43, "cmd": 44, "d0": 39, "d1": 40, "d2": 41, "d3": 42}}
    },
    "power": [
        {"name": "USB", "source": "usb", "mv": 5000},
        {"name": "VIN", "source": "vin", "why": "Contact 1 of CN2."},
        {
            "name": "5V",
            "from": ["USB", {"name": "VIN", "through": "q_vin"}],
            "feeds": ["rs485"],
            "why": "The net USB5V_IN, on J4 and J5."
        },
        {"name": "BAT+", "source": "battery", "why": "CN4."},
        {
            "name": "VOUT-BAT",
            "from": ["5V", "BAT+"],
            "through": "charger",
            "regulator": "charger",
            "mv": 5000,
            "feeds": ["amplifier"]
        },
        {
            "name": "LEDA",
            "from": "VOUT-BAT",
            "through": "led_driver",
            "regulator": "boost",
            "feeds": ["lcd"],
            "why": "EN of IC1 is LCD_PWM, the backlight line of the display on GPIO23, held low by R72."
        },
        {"name": "VCC5V", "from": "VOUT-BAT", "through": "fuse"},
        {
            "name": "3V3",
            "from": "VCC5V",
            "through": "reg_3v3",
            "regulator": "buck",
            "mv": 3300,
            "ma_max": 2000,
            "feeds": ["mcu", "radio", "lcd", "touch", "sound"],
            "why": "The nets VCC3V3, ESP_3V3 and VDDA are one. The net Codec_3V3 hangs on it through R9, 0 ohm."
        },
        {"name": "ESP_LDO_VO4", "from": "3V3", "why": "LDO channel 4 of the chip."},
        {
            "name": "TF_VCC",
            "from": "ESP_LDO_VO4",
            "through": "q_sd",
            "feeds": ["sd"],
            "why": "R10 from GPIO45 to the gate of Q1 is marked NC and R13 holds the gate low, so Q1 stays on and no GPIO switches the card."
        }
    ],
    "connectors": {
        "CN1": {"type": "speaker, 2 pins", "pins": ["SPK+", "SPK-"]},
        "CN2": {"type": "MX 1.25 mm, 4 pins", "pins": ["VIN", 37, 38, "GND"]},
