{
    "format": "jef-sure/boards",
    "format_version": 1,
    "name": "cyd",
    "title": "CYD (ESP32-2432S028R)",
    "description": "2.8-inch 320x240 ILI9341 on SPI2, lying landscape; a resistive XPT2046 touch on SPI3 (one finger); sound the chip's own 8-bit DAC on GPIO26 through the board's amplifier; the BOOT button; the microSD slot wired to pins no host is left for (spi3 is the touch's): kept as data for the program",
    "mcu": {
        "target": "esp32",
        "flash_mb": 4,
        "notes": "the ESP32 has two SPI hosts for the program: SPI2 the display, SPI3 the touch; the SD slot's pins (23, 19, 18, cs 5) have no host left and are data only (buses.sdspi.sd)"
    },
    "display": {
        "driver": "ili9341",
        "bus": {
            "bus": "spi.spi2",
            "cs": 15,
            "dc": 2
        },
        "panel": {
            "width": 240,
            "height": 320,
            "mm_w": 43,
            "mm_h": 58
        },
        "original_orientation": {
            "x": "right-left",
            "y": "top-bottom",
            "swap": true
        },
        "backlight_on_high": true,
        "rst": null,
        "backlight": 21,
        "depth_bits": 16
    },
    "buses": {
        "spi": {
            "spi2": {
                "hz": 40000000,
                "mosi": 13,
                "miso": 12,
                "sclk": 14
            },
            "spi3": {
                "hz": 1000000,
                "mosi": 32,
                "miso": 39,
                "sclk": 25
            }
        },
        "sdspi": {
            "sd": {
                "mosi": 23,
                "miso": 19,
                "sclk": 18,
                "cs": 5
            }
        }
    },
    "sound": {
        "kind": "dac",
        "out": 26,
        "pa": null,
        "sample_rate": 22050
    },
    "button": {
        "pin": 0,
        "active_low": true
    },
    "touch": {
        "kind": "esp_lcd_touch",
        "component": "atanisoft/esp_lcd_touch_xpt2046",
        "header": "esp_lcd_touch_xpt2046.h",
        "bus": "spi.spi3",
        "cs": 33,
        "irq": 36,
        "hz": 1000000,
        "fingers": 1,
        "x_max": 4095,
        "y_max": 4095,
        "resistive": true,
        "calibration": {
            "measured": false,
            "x_min": 0,
            "x_max": 4095,
            "y_min": 0,
            "y_max": 4095,
            "width": 320,
            "height": 240,
            "flags": 0,
            "knots_x": 3,
            "knots_y": 3,
            "rounds": 3,
            "affine": [
                40960,
                0,
                0,
                0,
                40960,
                0
            ],
            "x": [
                [
                    300,
                    300
                ],
                [
                    2048,
                    2048
                ],
                [
                    3800,
                    3800
                ]
            ],
            "y": [
                [
                    300,
                    300
                ],
                [
                    2048,
                    2048
                ],
                [
                    3800,
                    3800
                ]
            ],
            "down_ms": 20,
            "up_ms": 40,
            "blink_ms": 0,
            "gap_ms": 0,
            "off_tenths": 0,
            "worst_tenths": 0,
            "left_tenths": 0,
            "left_worst_tenths": 0
        }
    }
}
