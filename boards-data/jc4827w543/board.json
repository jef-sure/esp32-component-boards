{
    "format": "jef-sure/boards",
    "format_version": 1,
    "name": "jc4827w543",
    "title": "Guition JC4827W543",
    "description": "4.3-inch 480x272 NV3041A on QSPI, GT911 touch on its own I2C; an ESP32-S3 with 8 MB octal PSRAM",
    "mcu": {
        "target": "esp32s3",
        "flash_mb": 4,
        "psram_mb": 8,
        "notes": "the QSPI bus divides 80 MHz by a whole number; 80 MHz garbles the picture on this board, so it runs at 40"
    },
    "display": {
        "driver": "nv3041a",
        "panel": {
            "width": 480,
            "height": 272,
            "mm_w": 95,
            "mm_h": 54
        },
        "backlight_on_high": true,
        "rst": null,
        "backlight": 1,
        "depth_bits": 16,
        "original_orientation": {
            "x": "left-right",
            "y": "top-bottom",
            "swap": false
        },
        "bus": {
            "bus": "qspi.spi2",
            "cs": 45
        }
    },
    "touch": {
        "kind": "gt911",
        "bus": "i2c.i2c0",
        "address_try": [
            "0x5d"
        ],
        "x_max": 479,
        "y_max": 271,
        "fingers": 5,
        "rst": 38,
        "int": 3,
        "calibration": {
            "x_min": 0,
            "x_max": 479,
            "y_min": 0,
            "y_max": 271,
            "width": 480,
            "height": 272,
            "flags": 3,
            "knots_x": 3,
            "knots_y": 3,
            "rounds": 3,
            "affine": [
                65793,
                585,
                -8323,
                570,
                69648,
                -1428555
            ],
            "x": [
                [
                    35,
                    34
                ],
                [
                    237,
                    240
                ],
                [
                    446,
                    445
                ]
            ],
            "y": [
                [
                    35,
                    34
                ],
                [
                    135,
                    136
                ],
                [
                    237,
                    237
                ]
            ],
            "down_ms": 0,
            "up_ms": 30,
            "blink_ms": 0,
            "gap_ms": 0,
            "off_tenths": 121,
            "worst_tenths": 180,
            "left_tenths": 16,
            "left_worst_tenths": 40
        }
    },
    "buses": {
        "qspi": {
            "spi2": {
                "hz": 40000000,
                "d0": 21,
                "d1": 48,
                "d2": 40,
                "d3": 39,
                "sclk": 47
            }
        },
        "i2c": {
            "i2c0": {
                "sda": 8,
                "scl": 4
            }
        }
    }
}
