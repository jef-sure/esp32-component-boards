                            "rounds": 3,
                            "affine": [66171, 447, -375665, -881, 67265, -193200],
                            "x": [[34, 34], [240, 241], [445, 445]],
                            "y": [[34, 33], [136, 137], [237, 236]],
                            "down_ms": 0,
                            "up_ms": 30,
                            "blink_ms": 0,
                            "gap_ms": 0,
                            "off_tenths": 44,
                            "worst_tenths": 90,
                            "left_tenths": 24,
                            "left_worst_tenths": 50
                        }
                    ]
                }
            }
        },
        "sound": {"chip": "i2s_amp", "ref": "U4", "on": {"i2s.i2s0": {}}, "config": {"sample_rate": 22050}},
        "boot": {"class": "button", "pins": {"in": {"gpio": 0, "active": "low"}}},
        "sd": {"class": "storage", "ref": "TF1", "on": {"spi.spi3": {"cs": 10}}, "config": {"media": "microsd"}},
        "s3_module": {"class": "other", "ref": "IC1", "maker": "espressif", "part": "ESP32-S3-WROOM-1"},
        "charger": {
            "class": "other",
            "ref": "U2",
            "notes": "The schematic gives no part number. Its pins are those of the IP5306 on the JC1060P470C."
        },
        "reg_3v3": {
            "class": "other",
            "ref": "U3",
            "notes": "The schematic gives no part number: a buck converter by its pins and L3."
        },
        "d_usb": {"class": "other", "ref": "D1", "part": "1N5819W"},
        "q_vin": {"class": "other", "ref": "Q1", "part": "AO3401"}
    }
