{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "board",
    "name": "chip_found_at_start",
    "title": "One of two touch chips, found at start",
    "mcu": {"target": "esp32s3"},
    "checked": {"pins": {"level": "unchecked", "source": "shape only"}},
    "buses": {"spi": {"spi2": {"mosi": 12, "miso": "nc", "sclk": 13}}, "i2c": {"i2c0": {"sda": 8, "scl": 9}}},
    "devices": {
        "lcd": {
            "chip": "st7789",
            "on": {"spi.spi2": {"cs": 10}},
            "pins": {"dc": 11},
            "config": {"primary": true, "panel": {"width": 240, "height": 320, "mm_w": 37, "mm_h": 49}},
            "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}}
        },
        "touch": {
            "class": "touch",
            "chip_try": ["gt911", "cst816"],
            "on": {"i2c.i2c0": {"address_try": ["0x5d", "0x15"]}},
            "config": {"over": "lcd", "x_max": 239, "y_max": 319, "fingers": 2}
        }
    }
}
