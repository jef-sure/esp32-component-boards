# ESP32-S3 DevKit: what its chip and its memory need, read before the program's own
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_SELECT_ESP32S3_DEVKIT=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 8 MB octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
