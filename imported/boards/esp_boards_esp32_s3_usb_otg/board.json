        "fs_sdcard": {"class": "storage", "config": {"media": "microsd"}, "on": {"sdmmc.sdmmc0": {}}},
        "usb_mode_select": {"class": "other", "pins": {"out": 18}},
        "led_green": {"class": "led", "pins": {"out": 15}},
        "led_yellow": {"class": "led", "pins": {"out": 16}},
        "button_ok": {"class": "button", "pins": {"in": {"gpio": 0, "active": "low"}}},
