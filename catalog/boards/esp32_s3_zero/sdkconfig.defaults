# The Waveshare ESP32-S3-Zero: what its chip and its memory need, read before the program's own
# defaults. The first two lines are the choice of the board.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_SELECT_ESP32_S3_ZERO=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 2 MB quad PSRAM in the package of the ESP32-S3FH4R2
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
