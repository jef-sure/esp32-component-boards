{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "board",
    "name": "m5stack_boards_m5stack_core",
    "title": "M5Stack Core with ILI9341 LCD, buttons, speaker, and SPI microSD",
    "mcu": {"target": "esp32"},
    "buses": {"i2c": {"i2c0": {"sda": 21, "scl": 22}}, "spi": {"spi2": {"mosi": 23, "miso": 19, "sclk": 18}}},
    "devices": {
        "ip5306_power_manager": {"class": "pmic", "on": {"i2c.i2c0": {"address": "0x75"}}},
        "display_lcd": {
            "class": "display",
            "on": {"spi.spi2": {"cs": 14, "hz": 40000000, "mode": 0}},
            "pins": {"dc": 27, "rst": 33, "backlight": 32},
            "config": {
                "kind": "graphics",
                "panel": {"width": 320, "height": 240},
                "primary": true,
                "depth_bits": 16,
                "invert": false,
                "color_order": "bgr"
            },
            "controls": {
                "orientation": {"how": "driver", "start": {"x": "right-left", "y": "top-bottom", "swap": false}},
                "backlight": {"how": "backlight_pwm", "min": 0, "max": 100, "start": 100}
            },
            "chip": "ili9341"
        },
        "speaker_enable": {"class": "other", "pins": {"out": 25}},
        "button_prev": {"class": "button", "pins": {"in": {"gpio": 39, "active": "low"}}},
        "button_enter": {"class": "button", "pins": {"in": {"gpio": 38, "active": "low"}}},
        "button_next": {"class": "button", "pins": {"in": {"gpio": 37, "active": "low"}}},
        "fs_sdcard": {"class": "storage", "config": {"media": "microsd"}, "on": {"spi.spi2": {"cs": 4}}}
    },
    "origin": {
        "from": "m5stack_boards",
        "ref": "0.6.1~2",
        "path": "m5stack_core",
        "license": "Espressif Modified MIT License",
        "tool": "tools/import_board_manager.py",
        "date": "2026-11-01"
    },
    "checked": {"pack": {"level": "extracted", "source": "m5stack_boards 0.6.1~2"}}
}
