# The settings of the radio of the board, read only when the program turns the radio on (CONFIG_BOARD_RADIO=y):
# while it is off, esp_hosted is not in the build and no Kconfig knows its settings.
# Wi-Fi and Bluetooth LE are in the ESP32-C6 beside the chip, on SDIO: esp_hosted talks to it. Its pins are those of
# buses.sdio.sdio0 of board.json, on slot 1 of the SDIO host, four data lines; tools/check_boards.py checks they agree.
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54
# The Bluetooth controller is in the C6 too: a program's NimBLE reaches it through esp_hosted, not a UART.
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
