# The Guition JC1060P470C (7-inch): what its chip, its memory and its flash need, read before
# the program's own defaults (SDKCONFIG_DEFAULTS of the project, tools/board_select.py puts
# this file there). The first two lines are the choice of the board: the chip, and the board
# in the menu of the configuration. The DGX drivers its panel needs (DSI, JD9165) come with
# that choice.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_BOARD_SELECT_JC1060P470C=y

# 16 MB flash: a BoyaMicro chip, on four lines at 80 MHz, as in the examples of Guition
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 32 MB PSRAM, hexagonal: the two frame buffers of the panel live in it. Its speed and the CPU follow
# the revision of the chip: tools/board_select.py writes them.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
# drawing goes through the cache of the PSRAM: a larger one makes it faster and takes internal RAM
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Wi-Fi and Bluetooth LE are in the ESP32-C6 beside the chip, on SDIO: esp_hosted talks to it. Its pins are those of
# buses.sdio.sdio0 of board.json, on slot 1 of the SDIO host, four data lines; tools/check_boards.py checks they agree.
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54
# The Bluetooth controller is in the C6 too: a program's NimBLE reaches it through esp_hosted, not a UART.
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
