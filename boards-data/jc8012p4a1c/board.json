{
    "format": "jef-sure/boards",
    "format_version": 1,
    "name": "jc8012p4a1c",
    "title": "Guition JC8012P4A1C",
    "description": "10.1-inch 800x1280 JD9365 on MIPI-DSI (lying 1280x800), GSL3680 touch (firmware written into it at start), ES8311 sound",
    "mcu": {
        "target": "esp32p4",
        "flash_mb": 16,
        "psram_mb": 32,
        "revision_min": 300,
        "notes": "the chip of rev 3.2 on the board measured; a chip below rev 3 wants PSRAM at 200 MHz and ESP32P4_SELECTS_REV_LESS_V3"
    },
    "display": {
        "driver": "jd9365",
        "panel": {
            "width": 800,
            "height": 1280,
            "mm_w": 136,
            "mm_h": 217
        },
        "backlight_on_high": true,
        "rst": 27,
        "backlight": 23,
        "depth_bits": 16,
        "original_orientation": {
            "x": "right-left",
            "y": "top-bottom",
            "swap": true
        },
        "bus": {
            "bus": "dsi.dsi0"
        }
    },
    "touch": {
        "kind": "gsl3680",
        "bus": "i2c.i2c0",
        "x_max": 1663,
        "y_max": 895,
        "fingers": 5,
        "rst": 22,
        "int": 21,
        "firmware": "embedded",
        "calibration": {
            "x_min": 0,
            "x_max": 1663,
            "y_min": 0,
            "y_max": 895,
            "width": 800,
            "height": 1280,
            "flags": 6,
            "knots_x": 3,
            "knots_y": 3,
            "rounds": 3,
            "affine": [
                65301,
                579,
                774524,
                -221,
                66564,
                -691501
            ],
            "x": [
                [
                    44,
                    48
                ],
                [
                    407,
                    399
                ],
                [
                    747,
                    751
                ]
            ],
            "y": [
                [
                    47,
                    48
                ],
                [
                    642,
                    640
                ],
                [
                    1230,
                    1231
                ]
            ],
            "down_ms": 50,
            "up_ms": 60,
            "blink_ms": 22,
            "gap_ms": 0,
            "off_tenths": 181,
            "worst_tenths": 220,
            "left_tenths": 50,
            "left_worst_tenths": 110
        }
    },
    "sound": {
        "kind": "es8311",
        "bus": "i2c.i2c0",
        "address": "0x18",
        "pa_voltage": 5.0,
        "codec_dac_voltage": 3.3,
        "sample_rate": 22050,
        "volume": 25,
        "pa": 20,
        "i2s_bus": "i2s.i2s0"
    },
    "buses": {
        "dsi": {
            "dsi0": {
                "lanes": 2,
                "lane_mbps": 1000,
                "phy_ldo_chan": 3,
                "phy_ldo_mv": 2500
            }
        },
        "i2c": {
            "i2c0": {
                "sda": 7,
                "scl": 8
            }
        },
        "i2s": {
            "i2s0": {
                "mclk": 13,
                "bclk": 12,
                "ws": 10,
                "dout": 9,
                "din": 11
            }
        },
        "sdio": {
            "sdio0": {
                "clk": 18,
                "cmd": 19,
                "d0": 14,
                "d1": 15,
                "d2": 16,
                "d3": 17,
                "reset": 54
            }
        }
    }
}
