# The Kconfig of the boards, made by tools/boards_gen.py --all from catalog/: do not edit
# by hand. One choice of the board, one option a module, and beside them the hidden symbols
# the rules of idf_component.yml look at, so that the parts a board needs others than this
# component come only with the board that needs them (the model of esp-bsp's bsp_selector).
menu "Boards"

choice BOARD_SELECT
    prompt "Board the program runs on"
    default BOARD_SELECT_NONE
    help
        One board of catalog/boards/, or none (the program sets its hardware up
        itself). The board's own sdkconfig.defaults carries the line that
        chooses it here (CONFIG_BOARD_SELECT_<BOARD>=y, tools/board_select.py
        puts the file into the project); what the choice takes with it, the
        drivers of DGX its panel needs, comes as selects, and the parts others
        than DGX (a touch driver, a codec) by the rules of idf_component.yml on
        the symbols below.

config BOARD_SELECT_NONE
    bool "None: the program sets its hardware up itself"

config BOARD_SELECT_CYD_S028R
    bool "CYD (ESP32-2432S028R): 320x240 ILI9341, XPT2046 touch, DAC sound"
    depends on IDF_TARGET_ESP32
    select DGX_ENABLE_SPI
    select DGX_ENABLE_SPI_ILI_9341
    help
        2.8-inch 320x240 ILI9341 on SPI2, shown landscape; a resistive XPT2046
        touch on SPI3 (one finger); sound the chip's own 8-bit DAC on GPIO26
        through the board's amplifier; the BOOT button; the microSD slot wired
        to pins no host is left for (spi3 is the touch's): kept as data for the
        program.

config BOARD_SELECT_ESP32_C3_OLED_042
    bool "ESP32-C3 with a 0.42-inch OLED: 72x40 SSD1306"
    depends on IDF_TARGET_ESP32C3
    select DGX_ENABLE_I2C
    select DGX_ENABLE_SSD1306
    help
        A small ESP32-C3 board with a 72x40 SSD1306 OLED on I2C: 4 MB flash in
        the chip, USB-C to the chip, a power LED, a blue LED, BOOT and RST
        buttons, a ceramic antenna.

config BOARD_SELECT_ESP32_C3_ZERO
    bool "Waveshare ESP32-C3-Zero"
    depends on IDF_TARGET_ESP32C3
    help
        A small ESP32-C3 board: 4 MB flash in the chip, castellated holes, USB-C
        to the chip, a WS2812B, BOOT and RESET buttons, a ceramic antenna.

config BOARD_SELECT_ESP32_DEVKIT
    bool "ESP32 DevKit, 4 MB"
    depends on IDF_TARGET_ESP32
    help
        A standard ESP32 dev board with a CP210x USB bridge, a power LED, a
        second LED and a BOOT button.

config BOARD_SELECT_ESP32_DEVKIT_USB_C
    bool "ESP32 DevKit, 4 MB, USB-C"
    depends on IDF_TARGET_ESP32
    help
        The 30-pin ESP32 dev board with USB-C and a CH340 USB bridge, a power
        LED, a second LED and a BOOT button.

config BOARD_SELECT_ESP32_OLED_096
    bool "ESP32 with a 0.96-inch OLED: 128x64 SSD1306"
    depends on IDF_TARGET_ESP32
    select DGX_ENABLE_I2C
    select DGX_ENABLE_SSD1306
    help
        An ESP32 board with a 128x64 SSD1306 OLED on I2C, yellow on the top rows
        and blue below: a CP2102 USB bridge on micro-USB, EN and Boot buttons,
        no LEDs.

config BOARD_SELECT_ESP32_P4_ETH
    bool "Waveshare ESP32-P4-ETH: ES8311 sound"
    depends on IDF_TARGET_ESP32P4
    help
        An ESP32-P4 with 100 Mbit Ethernet on an IP101, an ES8311 with a
        microphone and a speaker output, a microSD slot, MIPI CSI and DSI
        connectors, a 40-pin header in the layout of a Pico. No radio.

config BOARD_SELECT_ESP32_P4_POE_ETH
    bool "Waveshare ESP32-P4-POE-ETH: ES8311 sound"
    depends on IDF_TARGET_ESP32P4
    help
        The ESP32-P4-ETH sold with a PoE module on its header H7.

config BOARD_SELECT_ESP32_S3_ZERO
    bool "Waveshare ESP32-S3-Zero"
    depends on IDF_TARGET_ESP32S3
    help
        A small ESP32-S3 board: 4 MB flash and 2 MB PSRAM in the chip,
        castellated holes, USB-C to the chip, a WS2812B, BOOT and RESET buttons,
        a ceramic antenna.

config BOARD_SELECT_ESP32S3_DEVKIT
    bool "ESP32-S3 DevKit, 16 MB, 8 MB PSRAM"
    depends on IDF_TARGET_ESP32S3
    help
        A standard ESP32-S3 dev board with two USB-C ports, a CH343 USB bridge
        on one of them, an RGB LED and a BOOT button.

config BOARD_SELECT_JC1060P470C
    bool "Guition JC1060P470C: 1024x600 JD9165, GT911 touch, ES8311 sound"
    depends on IDF_TARGET_ESP32P4
    select DGX_ENABLE_DSI
    select DGX_ENABLE_JD9165
    help
        7-inch 1024x600 JD9165 on MIPI-DSI, GT911 touch, ES8311 sound: an
        ESP32-P4 with Wi-Fi and BLE in an ESP32-C6 on the same module.

config BOARD_SELECT_JC4827W543C
    bool "Guition JC4827W543C: 480x272 NV3041A, GT911 touch, I2S amplifier sound"
    depends on IDF_TARGET_ESP32S3
    select DGX_ENABLE_SPI
    select DGX_ENABLE_NV3041A
    help
        4.3-inch 480x272 NV3041A on QSPI, GT911 touch on its own I2C; an
        ESP32-S3 with 8 MB octal PSRAM.

config BOARD_SELECT_JC8012P4A1C
    bool "Guition JC8012P4A1C: 1280x800 JD9365, GSL3680 touch, ES8311 sound"
    depends on IDF_TARGET_ESP32P4
    select DGX_ENABLE_DSI
    select DGX_ENABLE_JD9365
    help
        10.1-inch 800x1280 JD9365 on MIPI-DSI (shown 1280x800), GSL3680 touch
        (firmware written into it at start), ES8311 sound.

config BOARD_SELECT_NODEMCU_ESP32S
    bool "NodeMCU ESP-32S V1.1, 38 pins"
    depends on IDF_TARGET_ESP32
    help
        An ESP32 board in the layout of the ESP32-DevKitC: 38 pins, an
        ESP-WROOM-32, a CP2102 USB bridge on micro-USB, a power LED, a blue LED
        on GPIO 2, EN and BOOT buttons.

config BOARD_SELECT_HOST
    bool "The computer: a window of SDL2 as large as the board it shows"
    depends on IDF_TARGET_LINUX
    help
        The linux target of ESP-IDF: the program runs on the computer,
        src/board_host.c gives boards.h over SDL2. The display is a window of
        DGX as large as the display of the board shown, its touch the mouse as
        DGX-DI reads it; the sound goes to the speakers of the computer.
        tools/board_select.py host --as <board> writes the size of the board
        shown.

endchoice

if BOARD_SELECT_HOST
config BOARD_HOST_SHOWS
    string "The board the window shows"
config BOARD_HOST_WIDTH
    int "Its width in pixels, as shown"
    default 320
config BOARD_HOST_HEIGHT
    int "Its height in pixels, as shown"
    default 240
config BOARD_HOST_MM_W
    int "Its width in millimetres, 0 when the data has no size"
    default 0
config BOARD_HOST_MM_H
    int "Its height in millimetres, 0 when the data has no size"
    default 0
config BOARD_HOST_DIR_X
    int "The direction of x on its glass at start: 1, or -1 the other way"
    default 1
config BOARD_HOST_DIR_Y
    int "The direction of y on its glass at start: 1, or -1 the other way"
    default 1
config BOARD_HOST_SWAP
    int "1 when x and y are exchanged on its glass at start"
    default 0
config BOARD_HOST_TURN
    int "Its glass turned clockwise in the window as the board is held, degrees"
    default 0
config BOARD_HOST_BUS_HZ
    int "The clock of the bus of its display, 0 for the window's 40 MHz"
    default 0
config BOARD_HOST_BUS_LINES
    int "The data lines of that bus: 1 for SPI, 4 for QSPI, 0 for 1"
    default 0
config BOARD_HOST_COLOR_BITS
    int "Its depth of color, 16 or 18"
    default 16
config BOARD_HOST_BUTTONS
    string "The names of its buttons, by commas"
endif

config BOARD_SOUND_TASK_STACK
    int "Stack of the task of the sound, bytes"
    default 3072
    range 2048 65536
    help
        The task board_sound_start runs calls the source of the program on this
        stack: a source that logs, formats floats or keeps a buffer of its own
        needs more.

# Hidden symbols the rules of idf_component.yml and CMakeLists.txt look at: the board chosen,
# as a number (a number is easier for a rule to compare).
config BOARD_CYD_S028R
