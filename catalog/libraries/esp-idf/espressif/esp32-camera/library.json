    "chips": {
        "ov7670": {
            "header": "esp_camera.h",
            "on": ["dvp", "i2c"],
            "select": ["OV7670_SUPPORT"],
            "init": [
                {
                    "call": "esp_camera_init",
                    "args": ["{config}"],
                    "returns": "esp_err_t",
                    "ok": {"equals": "ESP_OK"},
                    "notes": "camera_config_t names the pins, the clock of XCLK, the pixel format and the frame buffers; the driver finds the sensor by its ID over SCCB."
                }
            ]
        },
