    "part": "JC4880P443C",
    "revision": "V1.0",
    "description": "4.3-inch 480x800 ST7701S on MIPI-DSI, GT911 touch, ES8311 sound: an ESP32-P4 with Wi-Fi and BLE in an ESP32-C6 on the same module",
    "mcu": {
        "target": "esp32p4",
        "flash_mb": 16,
        "psram_mb": 32,
        "revision": "3.2",
        "notes": "The core is the module JC-ESP32P4-M3, as on the JC1060P470C: an ESP32-P4, 16 MB flash, 32 MB PSRAM, an ESP32-C6. The chip of the board measured is of revision 3.2, its flash a Boya chip (68/4018)."
    },
    "checked": {
        "pins": {
            "level": "schematic",
            "source": "JC4880P443_V1.0.pdf, the archive JC4880P443C_I_W.zip of Guition",
            "date": "2026-11-18"
        },
        "chip": {
            "level": "hardware",
            "covers": ["mcu"],
            "source": "esptool on Anton's board: ESP32-P4 rev v3.2, 16 MB flash of maker 0x68 (4018), USB Serial/JTAG",
            "date": "2026-11-18"
        },
        "glass": {
            "level": "hardware",
            "covers": ["devices.lcd", "buses.dsi"],
            "by": "Anton, by eye",
            "date": "2026-11-18",
            "notes": "A DGX driver of the ST7701 not released yet, in the session of DGX: frame rings with the glass equal to the frame buffer, colors at 16 bits in RGB order, eight orientations, two lanes at 1000 Mbit/s, the reset on GPIO 5 and the backlight on GPIO 23 off for a second. This component does not start the display yet."
        },
        "touch_vendor": {
            "level": "vendor-code",
            "covers": ["devices.touch.config"],
            "source": "the BSP of Guition in the archive: esp_lcd_touch_new_i2c_gt911 at 0x5D, 480 x 800, its INT and RST left GPIO_NUM_NC",
            "date": "2026-11-18"
        },
        "radio_vendor": {
            "level": "vendor-code",
            "covers": ["buses.sdio", "devices.radio"],
            "source": "the sdkconfig of the demos of Guition for this board: esp_hosted on SDIO slot 1, CLK 18, CMD 19, D0 to D3 14 to 17, the reset of the C6 on GPIO 54",
            "date": "2026-11-18"
        },
        "schematic_parts": {
            "level": "schematic",
            "covers": [
                "devices.touch",
                "devices.sound",
                "devices.rs485",
                "devices.sd",
                "devices.radio",
                "devices.battery",
                "buses.uart",
                "buses.sdmmc",
                "buses.i2s.i2s0.din",
