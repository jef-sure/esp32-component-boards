{
    "expect": "schema: devices/touch/class",
    "board": {
        "format": "jef-sure/boards",
        "format_version": 2,
        "kind": "board",
        "name": "cyd_s024r",
        "title": "ESP32-2432S024R",
        "mcu": {
            "target": "esp32"
        },
        "checked": {
            "pins": {
                "level": "community",
                "source": "rzeldent/platformio-espressif32-sunton, esp32-2432S024R.json"
            }
        },
        "buses": {
            "spi": {
                "spi2": {
                    "hz": 40000000,
                    "mosi": 13,
                    "miso": 12,
                    "sclk": 14
                }
            }
        },
        "devices": {
            "lcd": {
                "chip": "ili9341",
                "on": {
                    "spi.spi2": {
                        "cs": 15
                    }
                },
                "config": {
                    "panel": {
                        "width": 240,
                        "height": 320,
                        "mm_w": 37,
                        "mm_h": 49
                    },
                    "primary": true
                },
                "controls": {
                    "orientation": {
                        "start": {
                            "x": "left-right",
                            "y": "top-bottom",
                            "swap": false
                        }
                    }
                },
                "pins": {
                    "dc": 2,
                    "rst": "nc",
                    "backlight": "nc"
                }
            },
            "touch": {
                "chip": "xpt2046",
                "on": {
                    "spi.spi2": {
                        "cs": 33,
                        "hz": 2000000
                    }
                },
                "pins": {
                    "int": 36
                },
                "config": {
                    "over": "lcd"
                },
                "class": "speaker"
            }
        }
    }
}
