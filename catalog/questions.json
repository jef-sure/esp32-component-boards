{
    "format": "jef-sure/boards",
    "format_version": 2,
    "questions": [
        {
            "id": "display",
            "text": "What shows things to the user?",
            "type": "choice",
            "choices": [
                {"value": "none", "text": "Nothing"},
                {"value": "character", "text": "A character display", "needs": {"class": "display", "where": {"config.kind": "character"}}},
                {"value": "graphics", "text": "A graphics display", "needs": {"class": "display", "where": {"config.kind": "graphics"}}}
            ]
        },
        {
            "id": "diagonal_in",
            "text": "Its diagonal at least, inches",
            "type": "number",
            "when": {"display": "graphics"},
            "limit": {"measure": "diagonal_in", "of": "display"}
        },
        {
            "id": "display_shape",
            "text": "Its shape",
            "type": "choice",
            "when": {"display": "graphics"},
            "limit": {"measure": "shape", "of": "display"},
            "choices": [{"value": "any", "text": "any"}, {"value": "round", "text": "round"}, {"value": "rectangular", "text": "rectangular"}]
        },
        {"id": "touch", "text": "A touch panel", "type": "flag", "needs": {"class": "touch"}},
        {"id": "sound", "text": "Sound", "type": "flag", "needs": {"class": "audio"}},
        {"id": "outputs", "text": "Tones and PWM", "type": "outputs"},
        {"id": "chain_outputs", "asked": "block", "text": "Outputs it drives: a digit has 8 segments, an 8x8 matrix 64 LEDs", "type": "number", "limit": {"measure": "chain", "of": ["led", "display"], "variant": ["matrix", "segment", "addressable", "shift_register"]}},
        {"id": "nfc_readers", "text": "NFC readers", "type": "count", "max": 4, "needs": {"class": "nfc"}},
        {"id": "nfc_range_mm", "asked": "block", "text": "Reading distance at least, mm, with the wall of the case", "type": "number", "when": {"nfc_readers": true}, "limit": {"measure": "range_mm", "of": "nfc"}},
        {"id": "nfc_gap_mm", "text": "Distance between the antennas of the readers, mm", "type": "number", "when": {"nfc_readers": {"at_least": 2}}, "limit": {"measure": "gap_mm", "of": "nfc"}},
        {
            "id": "nfc_cards",
            "asked": "block",
            "text": "Cards to read",
            "type": "choice",
            "when": {"nfc_readers": true},
            "limit": {"measure": "standard", "of": "nfc"},
            "choices": [
                {"value": "any", "text": "MIFARE, NTAG and the like: any reader"},
                {"value": "iso14443b", "text": "ISO 14443 B"},
                {"value": "felica", "text": "FeliCa"},
                {"value": "iso15693", "text": "ISO 15693: ICODE, NFC type 5"},
                {"value": "iso18000_3m3", "text": "ISO 18000-3M3: EPC"}
            ]
        },
        {"id": "wifi", "text": "Wi-Fi", "type": "flag", "needs": {"provides": "wifi"}},
        {"id": "bluetooth", "text": "Bluetooth", "type": "flag", "needs": {"provides": "bluetooth"}},
        {"id": "ethernet", "text": "Ethernet", "type": "flag", "needs": {"provides": "ethernet", "chip": "emac"}},
        {"id": "poe", "text": "Power over Ethernet", "type": "flag", "when": {"ethernet": true}, "needs": {"provides": "poe"}},
        {"id": "co2_up_to", "text": "Measures up to, ppm", "type": "number", "limit": {"of": "air", "variant": "co2", "field": "provides.air.specified", "fits": "up_to"}},
        {"id": "temperature_down_to", "text": "Measures down to, °C", "type": "number", "limit": {"of": "temperature", "field": "provides.temperature.specified", "fits": "down_to"}},
        {"id": "temperature_up_to", "text": "Measures up to, °C", "type": "number", "limit": {"of": "temperature", "field": "provides.temperature.specified", "fits": "up_to"}},
        {"id": "platform", "text": "Platform", "type": "choice", "top": true, "limit": {"measure": "platform"}, "choices": [
            {"value": "any", "text": "any"}, {"value": "esp_idf", "text": "ESP-IDF"}, {"value": "arduino_esp32", "text": "Arduino"}]},
        {"id": "platform_version", "text": "Version", "type": "version", "top": true, "when": {"platform": true}, "limit": {"measure": "platform_version"}},
        {"id": "budget", "text": "Budget for one kit", "type": "number", "top": true, "limit": {"measure": "price"}}
    ]
}
