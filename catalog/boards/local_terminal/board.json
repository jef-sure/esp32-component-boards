{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "board",
    "name": "local_terminal",
    "title": "Local terminal: ESP32, 2004 LCD, two PN532",
    "description": "An attendance terminal: an ESP32 dev board, two PN532 on SPI2 and SPI3 and a 2004 LCD on I2C",
    "notes": [
        "The 2004 LCD is the module lcd2004_pcf8574 on the I2C bus of the board.",
        "The PN532 modules take SPI on their I0, I1 switches."
    ],
    "mcu": {"target": "esp32", "flash_mb": 4},
    "buses": {
        "i2c": {"i2c0": {"sda": 21, "scl": 22}},
        "spi": {"spi3": {"mosi": 23, "miso": 19, "sclk": 18}, "spi2": {"mosi": 13, "miso": 12, "sclk": 14}}
    },
    "devices": {
        "nfc_in": {"chip": "pn532", "on": {"spi.spi3": {"cs": 5}}},
        "nfc_out": {"chip": "pn532", "on": {"spi.spi2": {"cs": 27}}}
    },
    "modules": {"screen": {"module": "lcd2004_pcf8574", "on": {"i2c.i2c0": {}}}},
    "checked": {
        "pins": {
            "level": "vendor-code",
            "source": "~/code-esp/local-terminal-firmware, main/main.c",
            "date": "2026-10-31"
        },
        "start": {
            "level": "hardware",
            "covers": ["devices.nfc_in", "devices.nfc_out"],
            "by": "log of terminal_test",
            "date": "2026-10-31",
            "notes": "both PN532 read cards over SPI with these pins: 515 reads in three minutes, no errors"
        }
    }
}
