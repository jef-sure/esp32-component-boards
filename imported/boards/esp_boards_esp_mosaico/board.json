{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "board",
    "name": "esp_boards_esp_mosaico",
    "title": "ESP-Mosaico (ESP32-S31NRV16, 480x480 CO5300 AMOLED touch panel)",
    "mcu": {"target": "esp32s31"},
    "buses": {
        "i2c": {"i2c0": {"sda": 0, "scl": 1}},
        "qspi": {"spi2": {"d0": 36, "d1": 51, "d2": 35, "d3": 9, "sclk": 44}},
        "i2s": {"i2s0": {"mclk": 54, "bclk": 37, "ws": 49, "dout": 52, "din": 40}},
        "dvp": {"cam": {"pclk": 17, "vsync": 55, "de": 19, "data": [16, 15, 33, 4, 14, 12, 18, 13]}}
    },
    "devices": {
        "usb_hs_console": {"class": "other"},
        "battery_monitor": {"class": "fuel_gauge", "chip": "bq27220"},
        "audio_dac": {
            "class": "audio",
            "on": {"i2s.i2s0": {}, "i2c.i2c0": {"address": "0x32"}},
            "config": {"direction": "both", "sample_rate": 16000},
            "chip": "es8311"
        },
        "lcd_power_ctrl": {"class": "pmic", "on": {}},
        "display_lcd": {
            "class": "display",
            "on": {"qspi.spi2": {"cs": 50, "mode": 0}},
            "pins": {"rst": 42},
            "config": {"kind": "graphics", "panel": {"width": 480, "height": 480}, "primary": true, "depth_bits": 16},
            "controls": {
                "orientation": {"how": "driver", "start": {"x": "left-right", "y": "top-bottom", "swap": false}}
            },
            "start": {"after": ["lcd_power_ctrl"]},
            "chip": "co5300"
        },
        "lcd_touch": {
            "class": "touch",
            "on": {"i2c.i2c0": {"address": "0x5a"}},
            "pins": {"int": 6},
            "config": {"over": "display_lcd", "x_max": 480, "y_max": 480},
            "chip": "cst9217"
        },
        "status_led": {"class": "led", "pins": {"out": 3}},
        "vibration_motor": {"class": "other", "pins": {"out": 8}},
        "ai_button": {"class": "button", "pins": {"in": {"gpio": 7, "active": "low"}}},
        "boot_button": {"class": "button", "pins": {"in": {"gpio": 61, "active": "low"}}},
        "camera": {
            "class": "camera",
            "on": {"i2c.i2c0": {"role": "control"}, "dvp.cam": {"role": "data"}},
            "pins": {"rst": 53, "pwdn": 48},
            "config": {},
            "start": {"after": ["lcd_power_ctrl"]}
        }
    },
    "origin": {
        "from": "esp_boards",
        "ref": "0.7.1",
        "path": "esp_mosaico",
