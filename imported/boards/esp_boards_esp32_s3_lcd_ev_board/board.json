{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "board",
    "name": "esp_boards_esp32_s3_lcd_ev_board",
    "title": "ESP32-S3-LCD-EV-Board with sub-board 2 GC9503 RGB LCD and FT5x06 touch",
    "mcu": {"target": "esp32s3"},
    "buses": {
        "i2c": {"i2c1": {"sda": 47, "scl": 48}},
        "i2s": {"i2s1": {"mclk": 5, "bclk": 16, "ws": 7, "dout": 6, "din": 15}},
        "rgb": {
            "display_lcd": {
                "de": 17,
                "vsync": 3,
                "hsync": 46,
                "pclk": 9,
                "data": [10, 11, 12, 13, 14, 21, 8, 18, 45, 38, 39, 40, 41, 42, 2, 1],
                "hz": 16000000
            }
        },
        "spi": {
            "soft0": {
                "mosi": {"via": "gpio_expander", "bit": 3},
                "miso": "nc",
                "sclk": {"via": "gpio_expander", "bit": 2}
            }
        }
    },
    "devices": {
        "gpio_expander": {
            "class": "io_expander",
            "on": {"i2c.i2c1": {"address": "0x40"}},
            "config": {"pins": 8},
            "chip": "tca9554"
        },
        "audio_dac": {
            "class": "audio",
            "on": {"i2s.i2s1": {"format": "tdm"}, "i2c.i2c1": {"address": "0x30"}},
            "config": {"direction": "out", "sample_rate": 22050},
            "chip": "es8311"
        },
        "audio_adc": {
            "class": "audio",
            "on": {"i2s.i2s1": {"format": "tdm"}, "i2c.i2c1": {"address": "0x41"}},
            "config": {"direction": "in", "sample_rate": 22050, "clock": "bclk"},
            "chip": "es7210"
        },
        "display_lcd": {
            "class": "display",
            "on": {
                "rgb.display_lcd": {"role": "data"},
                "spi.soft0": {"role": "control", "cs": {"via": "gpio_expander", "bit": 1}}
            },
            "pins": {},
            "config": {
                "kind": "graphics",
                "panel": {"width": 480, "height": 480},
                "primary": true,
                "depth_bits": 16,
                "invert": false,
                "color_order": "rgb",
                "timing": {
                    "pclk_hz": 16000000,
                    "hsync_pulse": 10,
                    "hsync_back": 10,
                    "hsync_front": 20,
                    "vsync_pulse": 10,
                    "vsync_back": 10,
                    "vsync_front": 10
                }
            },
            "controls": {
                "orientation": {"how": "driver", "start": {"x": "left-right", "y": "top-bottom", "swap": false}}
            },
            "start": {"after": ["gpio_expander"]},
            "chip": "gc9503"
        },
        "lcd_touch": {
            "class": "touch",
            "on": {"i2c.i2c1": {"address": "0x70"}},
            "pins": {},
            "controls": {
                "orientation": {"how": "driver", "start": {"x": "left-right", "y": "top-bottom", "swap": false}}
            },
            "config": {"over": "display_lcd", "x_max": 480, "y_max": 480},
            "chip": "ft5x06"
        },
        "boot_button": {"class": "button", "pins": {"in": {"gpio": 0, "active": "low"}}}
    },
    "origin": {
        "from": "esp_boards",
        "ref": "0.7.1",
        "path": "esp32_s3_lcd_ev_board",
        "license": "Espressif Modified MIT License",
        "tool": "tools/import_board_manager.py",
        "date": "2026-11-01"
    },
    "checked": {"pack": {"level": "extracted", "source": "esp_boards 0.7.1"}}
}
