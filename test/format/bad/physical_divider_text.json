{
    "expect": "is not of type 'object'",
    "board": {
        "format": "jef-sure/boards",
        "format_version": 2,
        "kind": "board",
        "mcu": {"target": "esp32s3"},
        "checked": {"pins": {"level": "unchecked", "source": "shape only"}},
        "name": "physical_divider_text",
        "title": "A divider as text",
        "buses": {"spi": {"spi2": {"mosi": 12, "miso": "nc", "sclk": 13}}},
        "devices": {
            "lcd": {
                "chip": "st7789",
                "on": {"spi.spi2": {"cs": 10}},
                "pins": {"dc": 11},
                "config": {"primary": true, "panel": {"width": 240, "height": 320}},
                "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}}
            },
            "battery": {"class": "battery_adc", "pins": {"in": 5}, "config": {"divider": "33k/100k"}}
        }
    }
}
