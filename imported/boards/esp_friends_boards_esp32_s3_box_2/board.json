        "fs_sdcard": {"class": "storage", "config": {"media": "microsd"}, "on": {"spi.spi2": {"cs": 15}}},
        "lcd_rd_gpio_ctrl": {"class": "other", "pins": {"out": 10}},
        "lcd_bl_gpio_ctrl": {"class": "other", "pins": {"out": 21}},
        "display_lcd": {
            "class": "display",
            "on": {"p8.display_lcd": {"cs": 14}},
            "pins": {},
            "config": {"kind": "graphics", "panel": {"width": 240, "height": 320}, "primary": true, "invert": true},
            "controls": {
                "orientation": {"how": "driver", "start": {"x": "left-right", "y": "top-bottom", "swap": false}}
            },
            "start": {"after": ["lcd_rd_gpio_ctrl", "lcd_bl_gpio_ctrl"]},
            "chip": "st7789"
        },
        "button_l": {"class": "button", "pins": {"in": "nc"}, "start": {"after": ["gpio_expander"]}},
        "button_m": {"class": "button", "pins": {"in": "nc"}, "start": {"after": ["gpio_expander"]}}
