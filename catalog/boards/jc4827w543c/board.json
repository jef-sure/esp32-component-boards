{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "board",
    "name": "jc4827w543c",
    "title": "Guition JC4827W543C",
    "maker": "guition",
    "part": "JC4827W543C",
    "revision": "V1.1",
    "description": "4.3-inch 480x272 NV3041A on QSPI, GT911 touch on its own I2C; an ESP32-S3 with 8 MB octal PSRAM",
    "notes": [
        "GPIO0 is the BOOT button and, through R9, the TE line of the panel. TE stays off until the panel is set up for it; with TE on, BOOT cannot be read.",
        "GPIO5 is the battery divider (33k over 100k, through R25) and contact 4 of P2 at once.",
        "The schematic also has a resistive touch, an XPT2046 on the lines of the TF slot: CS 38, CLK 12, DIN 11, DOUT 13, IRQ 3. This data is the capacitive board.",
        "The reset of the panel goes to an RC circuit, not to a GPIO.",
        "The speaker goes on connector P7. The amplifier has no volume of its own: a program scales its samples."
    ],
    "mcu": {
        "target": "esp32s3",
        "flash_mb": 4,
        "psram_mb": 8,
        "psram_mhz": 80,
        "notes": "the QSPI bus divides 80 MHz by a whole number; 80 MHz garbles the picture on this board, so it runs at 40"
    },
    "checked": {
        "pins": {
            "level": "schematic",
            "source": "JC4827W543 V1.1 and ESP32-4827A043 V0.2, 5-IO pin distribution of the vendor archive",
            "date": "2026-10-30"
        },
        "pin_table": {
            "level": "vendor-docs",
            "covers": ["buses.spi.spi3"],
            "source": "4.3 inches IO pin distribution.xlsx, vendor archive",
            "date": "2026-10-30",
            "result": "refuted",
            "notes": "it swaps TF_MOSI and TF_MISO against the schematic"
        },
        "touch": {
            "level": "hardware",
            "covers": ["devices.touch"],
            "by": "Anton",
            "date": "2026-10-30",
            "notes": "a dot under the finger, coordinates right"
        },
        "sound": {
            "level": "schematic",
            "covers": ["devices.sound"],
            "date": "2026-10-30",
            "result": "pending",
            "notes": "U4 on the schematic, connector P7 on the board; no speaker at hand, the tone was not heard"
        },
        "sound_start": {
            "level": "hardware",
            "covers": ["devices.sound"],
            "by": "log of hello_board",
            "date": "2026-10-30",
            "result": "pending",
            "notes": "the I2S starts and takes samples without errors; this says nothing of the amplifier"
        },
        "power": {
            "level": "schematic",
            "covers": ["power"],
            "source": "JC4827W543 V1.1 and ESP32-4827A043 V0.2",
            "date": "2026-10-31"
        }
    },
    "buses": {
        "spi": {"spi3": {"mosi": 11, "miso": 13, "sclk": 12}},
        "i2s": {"i2s0": {"mclk": "nc", "bclk": 42, "ws": 2, "dout": 41, "din": "nc"}},
        "qspi": {"spi2": {"hz": 40000000, "d0": 21, "d1": 48, "d2": 40, "d3": 39, "sclk": 47}},
        "i2c": {"i2c0": {"sda": 8, "scl": 4}}
    },
    "power": [
        {"name": "USB", "source": "usb", "mv": 5000, "why": "USB1, type C."},
        {"name": "VIN", "source": "vin", "why": "Contact 1 of P1."},
        {"name": "5V", "from": [{"name": "USB", "through": "d_usb"}, {"name": "VIN", "through": "q_vin"}]},
        {"name": "BAT+", "source": "battery", "why": "P6."},
        {"name": "VOUT-BAT", "from": ["5V", "BAT+"], "through": "charger", "regulator": "charger", "feeds": ["sound"]},
        {
            "name": "3V3",
            "from": "VOUT-BAT",
            "through": "reg_3v3",
            "regulator": "buck",
            "mv": 3300,
            "feeds": ["mcu", "lcd", "touch", "sd"],
            "why": "The net 3.3V of the schematic."
        }
    ],
    "shared_pins": {
        "boot_te": {
            "line": 0,
            "devices": ["lcd", "boot"],
            "only_while": {"device": "lcd", "control": "te", "value": "off"}
        }
    },
    "connectors": {
        "P1": {"type": "HC 1.25 mm, 4 pins", "pins": ["VIN", "U0TXD", "U0RXD", "GND"]},
        "P2": {"type": "HC 1.25 mm, 4 pins", "pins": [46, 9, 14, 5]},
        "P3": {"type": "HC 1.25 mm, 4 pins", "pins": [6, 7, 15, 16]},
        "P4": {"type": "HC 1.25 mm, 4 pins", "pins": ["GND", "3V3", 17, 18]},
        "P5": {"type": "SH 1.0 mm, 4 pins", "pins": ["GND", "3V3", 17, 18]},
        "P6": {"type": "JST 1.25 mm, 2 pins", "pins": ["BAT+", "BAT-"]},
        "P7": {"type": "JST 1.25 mm, 2 pins", "pins": ["SPK+", "SPK-"]}
    },
    "devices": {
        "battery": {
            "class": "battery_adc",
            "pins": {"in": 5},
            "config": {"divider": {"top_ohm": 33000, "bottom_ohm": 100000}}
        },
        "lcd": {
