            "on": {"qspi.spi2": {"cs": 45}},
            "pins": {"rst": "nc", "backlight": {"gpio": 1, "active": "high"}, "te": 0},
            "config": {
                "primary": true,
                "panel": {"width": 480, "height": 272, "mm_w": 95, "mm_h": 54},
                "depth_bits": 16
            },
            "controls": {
                "orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}},
                "te": {"how": "panel_command", "values": ["off", "on"], "start": "off", "read": "none"}
            }
        },
        "touch": {
            "chip": "gt911",
            "on": {"i2c.i2c0": {"address_try": ["0x5d"]}},
            "pins": {"rst": 38, "int": 3},
            "config": {
                "over": "lcd",
                "x_max": 479,
                "y_max": 271,
                "calibrations": {
                    "esp-idf/jef-sure/dgx-di": [
