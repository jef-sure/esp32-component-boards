{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "library",
    "ecosystem": "esp-idf",
    "owner": "espressif",
    "name": "esp_hosted",
    "title": "ESP-Hosted",
    "url": "https://components.espressif.com/components/espressif/esp_hosted",
    "license": "Apache-2.0",
    "install": [
        {"via": "registry"},
        {"via": "git", "url": "https://github.com/espressif/esp-hosted-mcu.git", "ref": "v{version}"}
    ],
    "described": "3.0.10",
    "chips": {
        "esp32c6": {
            "header": "esp_hosted.h",
            "on": ["sdio", "spi", "uart"],
            "init": [{"call": "esp_hosted_connect_to_slave", "args": [], "ok": {"equals": "0"}}],
            "adapter": {"kind": "esp_hosted", "function": "board_glue_radio_esp_hosted_start"}
        }
    },
    "adapter": {
        "version": "~3.0.9",
        "symbol": "BOARD_RADIO_ESP_HOSTED",
        "notes": "3.0.9 and 3.0.10 ran on the C6 of the JC1060P470C; 3.1.0 is not tried yet.",
        "headers": ["board_radio_esp_hosted.h"],
        "sources": {"BOARD_RADIO_ESP_HOSTED": ["board_radio_esp_hosted.c"]}
    },
    "checked": {
        "api": {
            "level": "vendor-code",
            "source": "host/compat/include/esp_hosted.h and esp_hosted_ota.h of 3.0.10",
            "date": "2026-11-15"
        },
        "radio": {
            "level": "hardware",
            "source": "the JC1060P470C: the version read and the firmware of the C6 sent by esp_hosted_slave_ota_*, 3.0.9 and 3.0.10",
            "by": "Anton",
            "date": "2026-11-15"
        }
    },
    "versions": {
        "3.1.0": {
            "targets": [
                "esp32",
                "esp32s2",
                "esp32s3",
                "esp32s31",
                "esp32c2",
                "esp32c3",
                "esp32c5",
                "esp32c6",
                "esp32c61",
                "esp32h2",
                "esp32h4",
                "esp32h21",
                "esp32p4"
            ],
            "requires": {
                "esp-idf/cherry-embedded/cherryusb": {
                    "version": ">=1.6.0",
                    "if": ["target in [esp32p4]", "$CONFIG{ESP_HOSTED_HOST_USB_CHERRYUSB_MANIFEST} == 1"]
                },
                "esp-idf/espressif/esp_tinyusb": {
                    "version": "*",
                    "if": ["target in [esp32s2, esp32s3, esp32s31]", "$CONFIG{ESP_HOSTED_CP_TINYUSB_MANIFEST} == 1"]
                },
                "esp-idf/espressif/iot_usbh_rndis": {
                    "version": "^0.5.2",
                    "if": ["target in [esp32p4]", "$CONFIG{ESP_HOSTED_HOST_USB_RNDIS_MANIFEST} == 1"]
                },
                "esp-idf/espressif/usb_host_cdc_acm": {
                    "version": "*",
                    "if": ["target in [esp32p4]", "$CONFIG{ESP_HOSTED_HOST_USB_CDC_ACM_MANIFEST} == 1"]
                }
            },
            "platforms": {"esp_idf": ">=5.5"}
        },
