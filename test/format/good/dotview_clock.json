{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "board",
    "name": "dotview_clock",
    "title": "Clock with dot indication: two SSD1351 as one screen",
    "mcu": {"target": "esp32"},
    "buses": {
        "spi": {
            "spi2": {"hz": 20000000, "mosi": 13, "miso": "nc", "sclk": 14},
            "spi3": {"hz": 20000000, "mosi": 23, "miso": "nc", "sclk": 18}
        }
    },
    "devices": {
        "left": {
            "chip": "ssd1351",
            "on": {"spi.spi2": {"cs": 15}},
            "pins": {"dc": 27, "rst": 33},
            "config": {"panel": {"width": 128, "height": 128, "mm_w": 27, "mm_h": 27}, "depth_bits": 16},
            "controls": {"orientation": {"start": {"x": "left-right", "y": "bottom-top", "swap": true}}}
        },
        "right": {
            "chip": "ssd1351",
            "on": {"spi.spi3": {"cs": 5}},
            "pins": {"dc": 25, "rst": 26},
            "config": {"panel": {"width": 128, "height": 128, "mm_w": 27, "mm_h": 27}, "depth_bits": 16},
            "controls": {"orientation": {"start": {"x": "right-left", "y": "top-bottom", "swap": true}}}
        },
        "light": {"class": "sensor", "pins": {"in": 32}, "provides": {"light": {}}},
        "config": {"class": "button", "pins": {"in": {"gpio": 19, "active": "low", "pull": "up"}}}
    },
    "display_groups": {"wide": {"how": "side_by_side", "left": "left", "right": "right", "primary": true}},
    "checked": {
        "pins": {"level": "community", "source": "jef-sure/dotview-clock, main/main.c"},
        "board": {
            "level": "hardware",
            "covers": ["display_groups.wide", "devices.left", "devices.right", "devices.light", "devices.config"],
            "by": "Anton and a probe of the group",
            "date": "2026-11-04",
            "notes": "The y of each panel is the opposite of main.c of dotview-clock: its copy of DGX scanned the SSD1351 from COM0, DGX 0.10 starts upright as Adafruit_SSD1351. A picture across the group, the light read while the screens lit it, the button pressed."
        }
    }
}
