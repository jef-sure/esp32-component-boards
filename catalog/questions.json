{
    "format": "jef-sure/boards",
    "format_version": 2,
    "questions": [
        {
            "id": "display",
            "text": "What shows things to the user?",
            "type": "choice",
            "choices": [
                {"value": "none", "text": "Nothing"},
                {"value": "character", "text": "A character display", "needs": {"class": "display", "where": {"config.kind": "character"}}},
                {"value": "graphics", "text": "A graphics display", "needs": {"class": "display", "where": {"config.kind": "graphics"}}}
            ]
        },
        {
            "id": "diagonal_in",
            "text": "Its diagonal at least, inches",
            "type": "number",
            "when": {"display": "graphics"},
            "limit": {"measure": "diagonal_in", "of": "display"}
        },
        {"id": "touch", "text": "A touch panel", "type": "flag", "needs": {"class": "touch"}},
        {"id": "sound", "text": "Sound", "type": "flag", "needs": {"class": "audio"}},
        {"id": "outputs", "text": "Tones and PWM", "type": "outputs"},
        {"id": "nfc_readers", "text": "NFC readers", "type": "count", "max": 4, "needs": {"class": "nfc"}},
        {"id": "nfc_range_mm", "text": "Reading distance at least, mm, with the wall of the case", "type": "number", "when": {"nfc_readers": true}, "limit": {"measure": "range_mm", "of": "nfc"}},
        {
            "id": "nfc_cards",
            "text": "Cards to read",
            "type": "choice",
            "when": {"nfc_readers": true},
            "limit": {"measure": "standard", "of": "nfc"},
            "choices": [
                {"value": "any", "text": "MIFARE, NTAG and the like: any reader"},
                {"value": "iso14443b", "text": "ISO 14443 B"},
                {"value": "felica", "text": "FeliCa"},
                {"value": "iso15693", "text": "ISO 15693: ICODE, NFC type 5"},
                {"value": "iso18000_3m3", "text": "ISO 18000-3M3: EPC"}
            ]
        },
        {"id": "wifi", "text": "Wi-Fi", "type": "flag", "needs": {"provides": "wifi"}},
        {"id": "bluetooth", "text": "Bluetooth", "type": "flag", "needs": {"provides": "bluetooth"}},
        {"id": "ethernet", "text": "Ethernet", "type": "flag", "needs": {"provides": "ethernet"}},
        {"id": "poe", "text": "Power over Ethernet", "type": "flag", "when": {"ethernet": true}, "needs": {"provides": "poe"}},
        {"id": "taken", "text": "GPIOs already in use, as 14, 15, 16", "type": "text"},
        {"id": "budget", "text": "Budget for one kit", "type": "number", "top": true, "limit": {"measure": "price"}}
    ]
}
