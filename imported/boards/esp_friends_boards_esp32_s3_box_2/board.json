{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "board",
    "name": "esp_friends_boards_esp32_s3_box_2",
    "title": "ESP32S3-BOX-2 Development Board",
    "mcu": {"target": "esp32s3"},
    "buses": {
        "i2c": {"i2c0": {"sda": 48, "scl": 47}},
        "i2s": {"i2s0": {"mclk": 38, "bclk": 40, "ws": 42, "dout": 41, "din": 39}},
        "spi": {"spi2": {"mosi": 16, "miso": 18, "sclk": 17}},
        "p8": {
            "display_lcd": {
                "d0": 13,
                "d1": 9,
                "d2": 8,
                "d3": 7,
                "d4": 6,
                "d5": 5,
                "d6": 4,
                "d7": 3,
                "wr": 11,
                "dc": 12,
                "hz": 10000000
            }
        }
    },
    "devices": {
        "gpio_expander": {
            "class": "io_expander",
            "on": {"i2c.i2c0": {"address": "0x40"}},
