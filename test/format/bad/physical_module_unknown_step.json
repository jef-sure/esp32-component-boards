{
    "expect": "power: no device VIN",
    "board": {
        "format": "jef-sure/boards",
        "format_version": 2,
        "kind": "board",
        "mcu": {"target": "esp32s3"},
        "checked": {"pins": {"level": "unchecked", "source": "shape only"}},
        "name": "physical_module_unknown_step",
        "title": "A line feeds a step of a module with no prefix",
        "buses": {"spi": {"spi2": {"mosi": 12, "miso": "nc", "sclk": 13}}, "i2c": {"i2c0": {"sda": 8, "scl": 9}}},
        "devices": {
            "lcd": {
                "chip": "st7789",
                "on": {"spi.spi2": {"cs": 10}},
                "pins": {"dc": 11},
                "config": {"primary": true, "panel": {"width": 240, "height": 320}},
                "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}}
            }
        },
        "power": [{"name": "5V", "source": "usb", "feeds": ["VIN"]}],
        "modules": {"reader": {"module": "powered_reader", "on": {"i2c.i2c0": {}}}}
    }
}
