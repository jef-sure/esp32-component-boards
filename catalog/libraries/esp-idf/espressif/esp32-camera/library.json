    "name": "esp32-camera",
    "title": "esp32-camera",
    "url": "https://github.com/espressif/esp32-camera",
    "license": "Custom",
    "install": [{"via": "registry"}, {"via": "git", "url": "https://github.com/espressif/esp32-camera.git"}],
