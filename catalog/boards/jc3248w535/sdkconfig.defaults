# The Guition JC3248W535 (3.5-inch): what its chip and its memory need, read before the
# program's own defaults (SDKCONFIG_DEFAULTS of the project, tools/board_select.py puts this
# file there). The first two lines are the choice of the board: the chip, and the board in
# the menu of the configuration. The DGX drivers its panel needs (SPI, AXS15231B) come with
# that choice.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_SELECT_JC3248W535=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 8 MB octal PSRAM; the screen of the AXS15231B keeps its picture there, 300 KB
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
