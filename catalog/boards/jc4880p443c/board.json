    "devices": {
        "lcd": {
            "chip": "st7701",
            "on": {"dsi.dsi0": {}},
            "pins": {"rst": 5, "backlight": {"gpio": 23, "active": "high"}},
            "config": {
                "primary": true,
                "panel": {"width": 480, "height": 800, "mm_w": 56, "mm_h": 94},
                "depth_bits": 16
            },
            "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}},
            "notes": "On FPC1, 30 pins: the reset is contact 23, TE is not wired. The active area is 56.16 x 93.60 mm by the specification of Guition."
        },
        "touch": {
            "chip": "gt911",
            "on": {"i2c.i2c0": {}},
            "pins": {"rst": 22, "int": 21},
            "config": {"over": "lcd", "x_max": 479, "y_max": 799},
            "notes": "On FPC1 with the display: TOUCH_RST contact 25, TOUCH_INT contact 28, the I2C on 26 and 27 with 5K1 to 3.3 V."
        },
        "sound": {
            "chip": "es8311",
            "ref": "U1",
            "part": "ES8311-S",
            "on": {"i2c.i2c0": {}, "i2s.i2s0": {}},
            "pins": {"pa": 11},
            "config": {"sample_rate": 22050, "pa_voltage": 5, "codec_dac_voltage": 3.3},
            "controls": {"volume": {"start": 25}},
            "notes": [
                "MIC1, an MSM381A3729H9CP, is on MIC1P and MIC1N of the codec: ASDOUT of the codec comes in on GPIO48. Only the output is set up.",
                "CE of the codec is held low through R1, so its address is 0x18. CN1 takes a speaker for the NS4150."
            ]
        },
        "boot": {"class": "button", "pins": {"in": {"gpio": 35, "active": "low"}}},
        "rs485": {
            "class": "network",
            "ref": "U8",
            "on": {"uart.uart1": {}},
            "config": {"transceiver": "MAX485", "direction": "auto"},
            "notes": "U7, a 74LVC1G132, and U9, an 8550, make the direction from TX: no GPIO sets it. U8 runs from USB5V_IN and its RO reaches RX1 on GPIO27 through R70, 0 ohm: by the schematic that is a level of 5 V on a pin of the chip, not measured. J5 brings IO26 and IO27 out beside it."
        },
        "sd": {
            "class": "storage",
            "ref": "J1",
            "on": {"sdmmc.sdmmc0": {}},
            "config": {"media": "microsd"},
            "notes": "Fed by LDO channel 4 of the chip, through Q1."
        },
        "radio": {
            "chip": "esp32c6",
            "on": {"sdio.sdio0": {}},
            "antenna": {"kind": "on_board", "form": "ceramic", "quality": 4},
            "notes": [
                "The ESP32-C6 inside the module, as on the JC1060P470C. ANT1, a ceramic CA-C03, is on LAN_OUT of the module through L4, 2.2 nH; C62 and C63 of its match are NC. Where ANT1 lies on the board, whether the module carries a connector for an antenna as well and which of them the radio uses is not seen.",
                "The net C6_IO2 joins GPIO6 of the P4 to IO2 of the C6."
            ]
        },
        "battery": {
            "class": "battery_adc",
            "pins": {"in": 53},
            "config": {"divider": {"top_ohm": 68000, "bottom_ohm": 100000}},
            "notes": "R55 is 0R on the schematic. The charger is an IP5306; SW3 is its KEY, with no line to the chip."
        },
        "p4_module": {"class": "other", "ref": "U3", "maker": "guition", "part": "JC-ESP32P4-M3"},
        "charger": {"class": "other", "ref": "U5", "maker": "injoinic", "part": "IP5306"},
        "reg_3v3": {"class": "other", "ref": "AP1", "maker": "ti", "part": "TLV62569"},
        "fuse": {
            "class": "other",
            "ref": "R22",
            "notes": "Drawn as a resistor with the value 1A, as on the JC1060P470C."
        },
        "led_driver": {"class": "other", "ref": "IC1", "part": "MP3202"},
        "amplifier": {"class": "other", "ref": "U2", "part": "NS4150"},
        "mic": {"class": "other", "ref": "MIC1", "part": "MSM381A3729H9CP"},
        "q_vin": {"class": "other", "ref": "Q2", "part": "AO3401"},
        "q_sd": {"class": "other", "ref": "Q1", "part": "AO3401"}
