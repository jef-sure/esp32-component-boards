{
    "expect": "stemma_qt has 4 contacts, not 3",
    "board": {
        "format": "jef-sure/boards",
        "format_version": 2,
        "kind": "board",
        "mcu": {"target": "esp32s3"},
        "checked": {"pins": {"level": "unchecked", "source": "shape only"}},
        "name": "physical_connector_contacts",
        "title": "Three contacts on a connector of four",
        "buses": {"spi": {"spi2": {"mosi": 12, "miso": "nc", "sclk": 13}}},
        "devices": {
            "lcd": {
                "chip": "st7789",
                "on": {"spi.spi2": {"cs": 10}},
                "pins": {"dc": 11},
                "config": {"primary": true, "panel": {"width": 240, "height": 320}},
                "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}}
            }
        },
        "connectors": {"J1": {"of": "stemma_qt", "pins": ["GND", 8, 9]}}
    }
}
