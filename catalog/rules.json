{
  "description": "What makes a resolved board wrong and a schema cannot see: references between devices. Read by rules.py and rules.js. {1}, {2} are the keys * matched, {value} the value, {owner} and {group} what a selector names, {node.x} a field of the node.",
  "sets": {
    "wired": [
      { "path": "devices.*.pins.*", "without": "analog", "owner": "{1}" },
      { "path": "devices.*.pins.*", "with": "analog", "owner": "the ladder on GPIO {node.gpio}" },
      { "path": "devices.*.on.*.cs", "owner": "{1}" },
      { "path": "devices.*.config.buttons.*", "without": "analog", "owner": "{1}" },
      { "path": "devices.*.config.buttons.*", "with": "analog", "owner": "the ladder on GPIO {node.gpio}" },
      { "path": "devices.*.config.divider.switch", "owner": "{1}" },
      { "path": "power.*.line", "where": [{ "path": "power.{1}.name" }], "let": { "step": "power.{1}.name" }, "owner": "power {step}" },
      { "path": "buses.*.*.*", "owner": "{1}.{2}" },
      { "path": "buses.*.*.data.*", "owner": "{1}.{2}" }
    ],
    "driven": [
      { "path": "devices.*.pins.*", "owner": "{1}", "where": [{ "text": "{2}", "in": ["dc", "rst", "backlight", "pa", "out", "latch", "clock", "xclk", "pwdn"] }] },
      { "path": "devices.*.on.*.cs", "owner": "{1}" },
      { "path": "devices.*.config.divider.switch", "owner": "{1}" },
      { "path": "power.*.line", "owner": "power" },
      { "path": "buses.spi.*.*", "owner": "spi.{1}", "where": [{ "text": "{2}", "in": ["mosi", "sclk"] }] },
      { "path": "buses.i2c.*.*", "owner": "i2c.{1}" }
    ],
    "elsewhere": [
      { "path": "power.*.line", "owner": "power" },
      { "path": "shared_pins.*.line", "owner": "shared_pins" },
      { "path": "connectors.*.pins.*", "owner": "connector {1}" }
    ],
    "connections": [
      { "path": "devices.*.on.*.address", "owner": "{1}", "group": "{2}" },
      { "path": "devices.*.on.*.address_try.0", "owner": "{1}", "group": "{2}" }
    ]
  },
  "rules": [
    { "id": "bus_exists", "kind": "exists", "when": [{ "path": "kind", "is": "board" }],
      "each": { "path": "devices.*.on.*", "as": "{2}", "strip": "\\.ch[0-7]$" },
      "among": [{ "path": "buses.*.*", "as": "{1}.{2}" },
                { "path": "devices.*", "where": [{ "path": "devices.{1}.classes", "has": "i2c_mux" }], "as": "i2c.{1}" }],
      "message": "{1}: the bus {value} is not among the board's buses" },
    { "id": "required_bus", "kind": "exists", "when": [{ "path": "kind", "is": "board" }],
      "each": { "path": "devices.*.wants.*", "where": [{ "path": "devices.{1}.wants.{2}.required", "is": true }], "as": "{1}:{2}" },
      "among": [{ "path": "devices.*.on.*", "as": "{1}:{2}", "strip": "\\..*$" }],
      "message": "{1}: it needs a bus of kind {2}" },
    { "id": "required_line", "kind": "exists", "when": [{ "path": "kind", "is": "board" }],
      "each": { "path": "devices.*.wants.*.lines.*", "as": "{1}:{node}" },
      "among": [{ "path": "devices.*.pins.*", "as": "{1}:{2}" }],
      "message": "{1}: it needs the line {node} wired in pins" },
    { "id": "via_expander", "kind": "exists", "each": ["wired", "elsewhere"], "with": "bit", "take": "via",
      "among": [{ "path": "devices.*", "where": [{ "path": "devices.{1}.classes", "has": "io_expander" }], "as": "{1}" }],
      "message": "{owner}: a line goes through {value}, which is not an io_expander" },
    { "id": "via_pmic", "kind": "exists", "each": ["wired", "elsewhere"], "with": "rail", "take": "via",
      "among": [{ "path": "devices.*", "where": [{ "path": "devices.{1}.classes", "has": "pmic" }], "as": "{1}" }],
      "message": "{owner}: a line goes through {value}, which is not a pmic" },
    { "id": "via_adc", "kind": "exists", "each": ["wired", "elsewhere"], "with": "channel", "take": "via",
      "among": [{ "path": "devices.*", "where": [{ "path": "devices.{1}.classes", "has": "adc" }], "as": "{1}" }],
      "message": "{owner}: a line goes through {value}, which is not an adc" },
    { "id": "over_display", "kind": "exists",
      "each": { "path": "devices.*.config.over", "where": [{ "path": "devices.{1}.config.over", "not": "none" }] },
      "among": [{ "path": "devices.*", "where": [{ "path": "devices.{1}.classes", "has": "display" }], "as": "{1}" }],
      "message": "{1}: over names {value}, which is not a display" },
    { "id": "one_touch_on_display", "kind": "unique",
      "each": { "path": "devices.*.config.over", "where": [{ "path": "devices.{1}.config.over", "not": "none" }], "owner": "{1}" },
      "message": "{owners} lie over one display" },
    { "id": "one_primary", "kind": "unique",
      "each": [{ "path": "devices.*.config.primary", "where": [{ "path": "devices.{1}.config.primary", "is": true }], "owner": "{1}" },
               { "path": "display_groups.*.primary", "where": [{ "path": "display_groups.{1}.primary", "is": true }], "owner": "{1}" }],
      "message": "more than one primary display: {owners}" },
    { "id": "gpio_one_owner", "kind": "unique", "each": "wired", "take": "gpio",
      "except": [{ "path": "shared_pins.*.line.gpio" }],
      "message": "GPIO {value} has two owners: {owners}" },
    { "id": "ladder_windows_apart", "kind": "apart",
      "each": [{ "path": "devices.*.pins.*", "with": "analog", "owner": "{1}", "group": "{node.gpio}" },
               { "path": "devices.*.config.buttons.*", "with": "analog", "owner": "{1}.{2}", "group": "{node.gpio}" }],
      "take": "analog",
      "message": "{owners} share a window on GPIO {group}" },
    { "id": "bit_one_owner", "kind": "unique", "each": "wired", "with": "bit", "as": "{node.via}.{node.bit}",
      "except": [{ "path": "shared_pins.*.line", "with": "bit", "as": "{node.via}.{node.bit}" }],
      "message": "the line {value} has two owners: {owners}" },
    { "id": "address_one_owner", "kind": "unique", "each": "connections",
      "message": "{owners} have address {value} on {group}" },
    { "id": "one_host_one_kind", "kind": "unique",
      "each": [{ "path": "buses.spi.*", "as": "{1}", "owner": "spi" }, { "path": "buses.qspi.*", "as": "{1}", "owner": "qspi" }],
      "message": "one SPI host is named both spi and qspi: {value}" },
    { "id": "calibration_range_x", "kind": "same", "each": { "path": "devices.*.config.calibrations.*" },
      "left": "devices.{1}.config.calibrations.{2}.x_max", "right": "devices.{1}.config.x_max",
      "message": "{1}: the calibration is for another touch range" },
    { "id": "calibration_range_y", "kind": "same", "each": { "path": "devices.*.config.calibrations.*" },
      "left": "devices.{1}.config.calibrations.{2}.y_max", "right": "devices.{1}.config.y_max",
      "message": "{1}: the calibration is for another touch range" },
    { "id": "calibration_width", "kind": "same", "each": { "path": "devices.*.config.calibrations.*", "let": { "over": "devices.{1}.config.over" } },
      "left": "devices.{1}.config.calibrations.{2}.width", "right": "devices.{over}.config.panel.width",
      "message": "{1}: the calibration is for another display size" },
    { "id": "calibration_height", "kind": "same", "each": { "path": "devices.*.config.calibrations.*", "let": { "over": "devices.{1}.config.over" } },
      "left": "devices.{1}.config.calibrations.{2}.height", "right": "devices.{over}.config.panel.height",
      "message": "{1}: the calibration is for another display size" },
    { "id": "start_in_limits", "kind": "within", "each": { "path": "devices.*.controls.*.start" },
      "min": "devices.{1}.controls.{2}.min", "max": "devices.{1}.controls.{2}.max", "values": "devices.{1}.controls.{2}.values",
      "message": "{1}: {2} starts at {value}, outside what it takes" },
    { "id": "psram_within_chip", "kind": "within", "each": { "path": "mcu.psram_mhz" }, "max": "mcu.facts.limits.psram_mhz",
      "message": "mcu: PSRAM at {value} MHz is above what this revision of the chip takes" },
    { "id": "mcu_start_in_limits", "kind": "within", "each": { "path": "mcu.controls.*.start" },
      "min": "mcu.facts.controls.{1}.min", "max": "mcu.facts.controls.{1}.max",
      "message": "the chip: {1} starts at {value}, outside what it takes" },
    { "id": "gpio_exists", "kind": "exists", "when": [{ "path": "kind", "is": "board" }], "each": ["wired", "elsewhere"], "take": "gpio",
      "among": [{ "path": "mcu.facts.gpio.valid.*" }],
      "message": "{owner}: the chip has no GPIO {value}" },
    { "id": "output_on_input_only", "kind": "forbid", "when": [{ "path": "kind", "is": "board" }], "each": "driven", "take": "gpio",
      "among": [{ "path": "mcu.facts.gpio.input_only.*" }],
      "message": "{owner}: GPIO {value} is input only" },
    { "id": "shared_devices_exist", "kind": "exists", "each": { "path": "shared_pins.*.devices.*" },
      "among": [{ "path": "devices.*", "as": "{1}" }], "message": "shared_pins {1}: no device {value}" },
    { "id": "feeds_exist", "kind": "exists", "each": { "path": "power.*.feeds.*" },
      "among": [{ "path": "devices.*", "as": "{1}" }, { "path": "power.*.name" }, { "path": "mcu.target", "as": "mcu" }, { "path": "modules.*.mcu.target", "as": "{1}_mcu" }],
      "message": "power: no device {value}" },
    { "id": "power_name_once", "kind": "unique", "each": { "path": "power.*.name", "owner": "{1}" }, "message": "power: two steps are named {value}" },
    { "id": "power_takes_earlier", "kind": "earlier", "each": { "path": "power.*.inputs.*.name", "let": { "step": "power.{1}.name" } },
      "among": [{ "path": "power.*.name" }], "message": "power {step}: no step {value} before it" },
    { "id": "power_through_exists", "kind": "exists", "each": { "path": "power.*.inputs.*.through.*", "let": { "step": "power.{1}.name" } },
      "among": [{ "path": "devices.*", "as": "{1}" }], "message": "power {step}: no device {value}" },
    { "id": "shared_only_while", "kind": "same",
      "each": { "path": "shared_pins.*.only_while", "let": { "device": "shared_pins.{1}.only_while.device", "control": "shared_pins.{1}.only_while.control" } },
      "left": "devices.{device}.controls.{control}.start", "right": "shared_pins.{1}.only_while.value",
      "message": "shared_pins {1}: the line is shared only while {device}.{control} is at the value that frees it" },
    { "id": "group_of_displays", "kind": "exists",
      "each": [{ "path": "display_groups.*.left" }, { "path": "display_groups.*.right" }],
      "among": [{ "path": "devices.*", "where": [{ "path": "devices.{1}.classes", "has": "display" }], "as": "{1}" }],
      "message": "display group {1}: {value} is not a display" },
    { "id": "one_group_of_a_display", "kind": "unique",
      "each": [{ "path": "display_groups.*.left", "owner": "{1}" }, { "path": "display_groups.*.right", "owner": "{1}" }],
      "message": "{value} is in more than one display group: {owners}" },
    { "id": "group_one_depth", "kind": "same",
      "each": { "path": "display_groups.*", "let": { "left": "display_groups.{1}.left", "right": "display_groups.{1}.right" } },
      "left": "devices.{left}.config.depth_bits", "right": "devices.{right}.config.depth_bits",
      "message": "display group {1}: the screen takes its depth from the left display, the right has another" },
    { "id": "library_of_the_chip", "kind": "exists", "each": { "path": "devices.*.library", "as": "{1}:{node}" },
      "among": [{ "path": "devices.*.libraries.*", "as": "{1}:{2}" }],
      "message": "{1}: its chip has no such library, or not in that version: {value}" },
    { "id": "library_does_what_is_needed", "kind": "exists",
      "each": { "path": "devices.*.needs.*.*", "let": { "library": "devices.{1}.library", "at": "devices.{1}.library_at" }, "as": "{1}:{library}:{2}:{node}" },
      "among": [{ "path": "devices.*.libraries.*.supports.*.*", "as": "{1}:{2}:{3}:{node}" }],
      "message": "{1}: {library} {at} does not do {node} of {2}" },
    { "id": "covers_exist", "kind": "path", "in_files": true, "each": { "path": "checked.*.covers.*" },
      "message": "checked {1}: this file has no {value}" },
    { "id": "connector_image_exists", "kind": "exists", "each": { "path": "connectors.*.at.image" },
      "among": [{ "path": "images.*", "as": "{1}" }], "message": "connector {1}: no image {value}" },
    { "id": "after_exist", "kind": "exists", "each": { "path": "devices.*.start.after.*" },
      "among": [{ "path": "devices.*", "as": "{1}" }], "message": "{1}: starts after {value}, which does not exist" }
  ]
}
