{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "library",
    "ecosystem": "esp-idf",
    "owner": "jef-sure",
    "name": "dgx-lvgl",
    "title": "DGX-LVGL",
    "url": "https://github.com/jef-sure/esp32-component-dgx-lvgl",
    "install": [
        {"via": "registry"},
        {"via": "git", "url": "https://github.com/jef-sure/esp32-component-dgx-lvgl.git", "ref": "{version}"}
    ],
    "described": "0.0.2",
    "description": "LVGL on the displays of DGX and the pointers of DGX-DI: it has no chips of its own.",
    "versions": {
        "0.0.2": {
            "requires": {
                "esp-idf/jef-sure/dgx": "^0.10.2",
                "esp-idf/jef-sure/dgx-di": "^0.1.3",
                "esp-idf/lvgl/lvgl": ">=9.3.0,<10.0.0"
            },
            "frameworks": {"esp-idf": ">=5.3.0"}
        },
        "0.0.1": {
            "requires": {
                "esp-idf/jef-sure/dgx": "^0.10.1",
                "esp-idf/jef-sure/dgx-di": "^0.1.3",
                "esp-idf/lvgl/lvgl": ">=9.3.0,<10.0.0"
            },
            "frameworks": {"esp-idf": ">=5.3.0"}
        }
    }
}
