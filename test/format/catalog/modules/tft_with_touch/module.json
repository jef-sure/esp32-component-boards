{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "module",
    "name": "tft_with_touch",
    "title": "A display with a touch on one SPI",
    "devices": {
        "lcd": {
            "chip": "st7789",
            "on": {"spi": {}},
            "config": {
                "primary": true,
                "panel": {"width": 240, "height": 320, "mm_w": 37, "mm_h": 49},
                "depth_bits": 16
            },
            "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}}
        },
        "touch": {
            "chip": "xpt2046",
            "on": {"spi": {}},
            "config": {"over": "lcd", "x_max": 4095, "y_max": 4095, "fingers": 1}
        }
    }
}
