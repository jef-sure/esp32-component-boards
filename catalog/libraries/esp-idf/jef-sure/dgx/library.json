                            "returns": "screen",
                            "ok": {"not": "NULL"}
                        }
                    ]
                }
            },
            "notes": "dgx_jd9165_init had no frames."
        },
        {"before": "0.5.0", "chips": {"jd9165": null}, "transports": {"dsi": null}}
    ],
