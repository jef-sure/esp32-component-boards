# The Waveshare ESP32-S3-Touch-AMOLED-1.32: what its chip and its memory need, read before
# the program's own defaults (SDKCONFIG_DEFAULTS of the project, tools/board_select.py puts
# this file there). The first two lines are the choice of the board: the chip, and the board
# in the menu of the configuration. The DGX drivers its panel needs (SPI, CO5300) come with
# that choice.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_SELECT_ESP32_S3_TOUCH_AMOLED_1_32=y

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 8 MB octal PSRAM in the chip; the virtual screen of the CO5300 driver, 434 KB, lives there
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
