# The Waveshare ESP32-P4-ETH: what its chip, its memory and its flash need, read before the program's
# own defaults. The first two lines are the choice of the board.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_BOARD_SELECT_ESP32_P4_ETH=y

# 32 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# 32 MB PSRAM, hexagonal, in the package of the chip. Its speed and the revision of the chip:
# tools/board_select.py writes them.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
