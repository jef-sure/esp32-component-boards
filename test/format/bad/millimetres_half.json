{
    "expect": "'mm_h' is a dependency of 'mm_w'",
    "board": {
        "format": "jef-sure/boards",
        "format_version": 2,
        "kind": "board",
        "name": "millimetres_half",
        "title": "Only one side measured",
        "mcu": {"target": "esp32s3"},
        "checked": {"pins": {"level": "unchecked", "source": "shape only"}},
        "buses": {"spi": {"spi2": {"mosi": 12, "miso": "nc", "sclk": 13}}},
        "devices": {
            "lcd": {
                "chip": "st7789",
                "on": {"spi.spi2": {"cs": 10}},
                "pins": {"dc": 11},
                "config": {"primary": true, "panel": {"width": 240, "height": 320, "mm_w": 37}},
                "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}}
            }
        }
    }
}
