config BOARD_NODEMCU_ESP32S
    int
    default 1 if BOARD_SELECT_NODEMCU_ESP32S
    default 0

# What the chosen board and the modules have, as the rules need it: a graphics display
# brings DGX, a touch brings DGX-DI and its driver, sound with an ES8311 brings esp_codec_dev,
# a character display brings hd44780. Derived from the data, so the data of a board and the
# rules cannot drift apart. The computer has a graphics display, its window a screen of DGX, and a
# touch, the mouse over it as DGX-DI reads it.
config BOARD_DISPLAY_GRAPHICS
    int
    default 1 if BOARD_SELECT_CYD_S028R || BOARD_SELECT_ESP32_C3_OLED_042 || BOARD_SELECT_ESP32_OLED_096 || BOARD_SELECT_JC1060P470C || BOARD_SELECT_JC4827W543C || BOARD_SELECT_JC8012P4A1C || BOARD_SELECT_HOST
    default 0

config BOARD_DISPLAY_GROUP
    int
    default 0

config BOARD_DISPLAY_HD44780
    int
    default 0

config BOARD_SOUND_DAC
    int
    default 1 if BOARD_SELECT_CYD_S028R
    default 0

config BOARD_SOUND_ES8311
    int
    default 1 if BOARD_SELECT_ESP32_P4_ETH || BOARD_SELECT_ESP32_P4_POE_ETH || BOARD_SELECT_JC1060P470C || BOARD_SELECT_JC8012P4A1C
    default 0

config BOARD_SOUND_I2S
    int
    default 1 if BOARD_SELECT_JC4827W543C
    default 0

config BOARD_TOUCH
    int
    default 1 if BOARD_SELECT_CYD_S028R || BOARD_SELECT_JC1060P470C || BOARD_SELECT_JC4827W543C || BOARD_SELECT_JC8012P4A1C || BOARD_SELECT_HOST
    default 0

config BOARD_TOUCH_ESP_LCD
    int
    default 1 if BOARD_SELECT_CYD_S028R || BOARD_SELECT_JC1060P470C || BOARD_SELECT_JC4827W543C
    default 0

config BOARD_TOUCH_GSL3680
    int
    default 1 if BOARD_SELECT_JC8012P4A1C
    default 0

config BOARD_TOUCH_GT911
    int
    default 1 if BOARD_SELECT_JC1060P470C || BOARD_SELECT_JC4827W543C
    default 0

config BOARD_TOUCH_SPI
    int
    default 1 if BOARD_SELECT_CYD_S028R
    default 0

config BOARD_TOUCH_XPT2046
    int
    default 1 if BOARD_SELECT_CYD_S028R
    default 0

endmenu
