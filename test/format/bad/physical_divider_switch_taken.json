{
    "expect": "GPIO 11 has two owners",
    "board": {
        "format": "jef-sure/boards",
        "format_version": 2,
        "kind": "board",
        "mcu": {"target": "esp32s3"},
        "checked": {"pins": {"level": "unchecked", "source": "shape only"}},
        "name": "physical_divider_switch_taken",
        "title": "A divider switched by the DC of the display",
        "buses": {"spi": {"spi2": {"mosi": 12, "miso": "nc", "sclk": 13}}},
        "devices": {
            "lcd": {
                "chip": "st7789",
                "on": {"spi.spi2": {"cs": 10}},
                "pins": {"dc": 11},
                "config": {"primary": true, "panel": {"width": 240, "height": 320}},
                "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}}
            },
            "battery": {
                "class": "battery_adc",
                "pins": {"in": 5},
                "config": {"divider": {"top_ohm": 1, "bottom_ohm": 1, "switch": 11}}
            }
        }
    }
}
