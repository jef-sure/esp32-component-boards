            "date": "2026-10-31",
            "result": "pending",
            "notes": "From the schematic: none of these was started on the board."
        },
        "photo": {
            "level": "hardware",
            "covers": ["devices.sd", "devices.rtc", "devices.led", "devices.battery", "devices.radio", "connectors"],
            "by": "Anton, photos of the open board",
            "date": "2026-10-31",
            "result": "confirmed",
            "notes": "That they are fitted, the battery and the speaker in the case too: none was started."
        }
    },
