{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "board",
    "name": "no_size_no_fingers",
    "title": "An imported board: no millimetres, the fingers from the chip",
    "mcu": {"target": "esp32s3"},
    "checked": {"pins": {"level": "unchecked", "source": "shape only"}},
    "buses": {"spi": {"spi2": {"mosi": 12, "miso": "nc", "sclk": 13}}, "i2c": {"i2c0": {"sda": 8, "scl": 9}}},
    "devices": {
        "lcd": {
            "chip": "st7789",
            "on": {"spi.spi2": {"cs": 10}},
            "pins": {"dc": 11},
            "config": {"primary": true, "panel": {"width": 240, "height": 320}},
            "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}}
        },
        "touch": {"chip": "gt911", "on": {"i2c.i2c0": {}}, "config": {"over": "lcd", "x_max": 239, "y_max": 319}}
    }
}
