{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "board",
    "mcu": {"target": "esp32", "part": "ESP32-D0WD-V3", "flash_mb": 4, "draw": {"active": {"ma": 80, "ma_peak": 500}}},
    "checked": {"pins": {"level": "unchecked", "source": "shape only"}},
    "name": "physical_two_inputs",
    "title": "Two ways in, two regulators, a chip on two lines",
    "maker": "jingcai",
    "part": "ESP32-2432S028R",
    "revision": "V0.1",
    "buses": {"spi": {"spi2": {"mosi": 13, "miso": 12, "sclk": 14}}},
    "power": [
        {"name": "USB", "source": "usb", "mv": 5000},
        {"name": "VIN", "source": "vin"},
        {
            "name": "5V",
            "from": [{"name": "USB", "through": "d_usb", "dropout_mv": 600}, {"name": "VIN", "through": "q_vin"}]
        },
        {"name": "BAT+", "source": "battery"},
        {"name": "VOUT-BAT", "from": ["5V", "BAT+"], "through": ["fuse", "charger"], "regulator": "charger", "mv": 5000},
        {
            "name": "3.3V-ESP",
            "from": "5V",
            "through": "reg_esp",
            "regulator": "ldo",
            "mv": 3300,
            "ma_max": 1000,
            "dropout_mv": 1300,
            "feeds": ["mcu"]
        },
        {
            "name": "3V3",
            "from": "VOUT-BAT",
            "through": "reg_tft",
            "regulator": "buck",
            "efficiency_percent": 90,
            "mv": 3300,
            "feeds": ["lcd", "usb_serial"]
        },
        {"name": "1V2", "from": "3V3", "through": "reg_core", "regulator": "buck", "mv": 1200, "feeds": ["mcu"]}
    ],
    "connectors": {"CN1": {"type": "HC 1.25 mm, 4 pins", "pins": ["3V3", 27, 22, "GND"]}},
    "devices": {
        "lcd": {
            "chip": "st7789",
            "on": {"spi.spi2": {"cs": 15}},
            "pins": {"dc": 2},
            "config": {"primary": true, "panel": {"width": 240, "height": 320}},
            "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}},
            "ref": "P2",
            "draw": {"on": {"ma": 120}, "sleep": {"ma": 1}}
        },
        "reg_esp": {"class": "other", "ref": "U7", "part": "AMS1117-3.3"},
        "reg_tft": {
            "class": "other",
            "ref": "U1",
            "maker": "ti",
            "notes": "a part with no number on the schematic has only its designator"
        },
        "reg_core": {"class": "other", "ref": "U3"},
        "charger": {"class": "other", "ref": "U5", "part": "IP5306", "maker": "injoinic"},
        "fuse": {"class": "other", "ref": "F1"},
        "d_usb": {"class": "other", "ref": "D1", "part": "1N5819W"},
        "q_vin": {"class": "other", "ref": "Q1", "part": "AO3401"},
        "usb_serial": {"class": "other", "ref": "U6", "part": "CH340C", "maker": "wch", "draw": {"active": {"ma": 12}}}
    }
}
