                            "ok": {"not": "NULL"}
                        }
                    ],
                    "supports": {"resolution": null}
                }
            },
            "notes": "dgx_st7789_init had no resolution."
        },
        {"before": "0.8.2", "chips": {"nv3041a": null}, "transports": {"qspi": null}},
        {"before": "0.8.0", "transports": {"spi": {"shared": null}, "i2c": {"shared": null}}},
        {"before": "0.6.3", "chips": {"sh1106": null, "ssd1309": null}},
        {"before": "0.6.2", "chips": {"jd9365": null}},
        {
            "before": "0.5.2",
