{
    "format": "jef-sure/boards",
    "format_version": 2,
    "kind": "project",
    "name": "my_board",
    "extends": "esp32s3_devkit",
    "title": "ESP32-S3 DevKit with my display and a 2004",
    "description": "The display module of this program and a 2004 character LCD on a PCF8574, connected to a dev board of the catalog by wires",
    "buses": {
        "qspi": {"spi2": {"hz": 40000000, "d0": 11, "d1": 13, "d2": 14, "d3": 9, "sclk": 12}},
        "i2c": {"i2c0": {"sda": 4, "scl": 5}}
    },
    "modules": {
        "screen": {
            "module": "my_display",
            "on": {"qspi.spi2": {"cs": 10}},
            "pins": {"rst": 8, "backlight": {"gpio": 18, "active": "high"}, "te": 17}
        },
        "text": {
            "module": "lcd2004_pcf8574",
            "on": {"i2c.i2c0": {}},
            "supply": {"VCC": "5V"},
            "devices": {"lcd": {"config": {"primary": false}}}
        }
    }
}
