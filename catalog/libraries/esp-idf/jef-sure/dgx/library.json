    "adapter": {
        "version": "^0.11.0",
        "symbol": "BOARD_DISPLAY_GRAPHICS",
        "requires": ["esp_driver_gpio"],
        "notes": "0.10.0 is not in the registry. 0.10.8 is the first that builds for the linux target of ESP-IDF: the window of the board host; 0.10.9 turns its glass as the board is held, 0.10.10 gives its mouse, 0.10.11 its keys and a window on no bus. 0.10.12 turns the SSD1306, SSD1309 and SH1106. 0.10.13 draws straight segments by the pen, 0.10.14 a filled circle with a soft edge and gives a screen its user_data. 0.10.16 has the 1.14-inch glass of the ST7789 and the NV3041A at 18 bits, 0.10.17 the SSD1680 of e-paper, whose glue calls dgx_ssd1680_init. 0.11.0 takes the backlight line in the constructor of every display that has one and lights it once the display is set up; it has the 0.96-inch glass of the ST7735.",
        "headers": ["board_display.h"],
        "public": "boards_dgx.h",
        "sources": {"BOARD_DISPLAY_GRAPHICS": ["board_display.c"]}
    },
    "checked": {
        "api": {
            "level": "vendor-code",
            "source": "include/drivers/, include/bus/ and Kconfig of esp32-component-dgx 0.11.0: every constructor of a display with a backlight takes its line after the reset line, the ST7735 takes a panel and has the 0.96-inch glass of 80x160, reading a display back through its window is gone, which the glue never called; by git diff of the tags 0.10.17 and 0.11.0 on 2026-11-14",
            "date": "2026-11-14"
        },
        "history": {
            "level": "vendor-code",
            "covers": ["history"],
            "source": "headers of include/ at every tag of esp32-component-dgx: the chips, the buses and the arguments of their init; before tag 0.1.0 nothing is known; 0.10.3 to 0.10.12 by the same headers at each tag on 2026-11-06, 0.10.13 and 0.10.14 on 2026-11-11, 0.10.15 to 0.10.17 on 2026-11-13, 0.11.0 on 2026-11-14",
            "date": "2026-10-31"
        }
    },
