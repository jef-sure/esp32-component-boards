{
    "expect": "does not do ndef_read of ntag",
    "board": {
        "format": "jef-sure/boards",
        "format_version": 2,
        "kind": "board",
        "name": "needs_met",
        "title": "A need the chosen library meets",
        "mcu": {
            "target": "esp32"
        },
        "buses": {
            "spi": {
                "spi2": {
                    "mosi": 13,
                    "miso": 12,
                    "sclk": 14
                }
            }
        },
        "devices": {
            "nfc": {
                "chip": "two_libraries",
                "on": {
                    "spi.spi2": {
                        "cs": 15
                    }
                },
                "library": "esp-idf/owner_a/idf_library",
                "needs": {
                    "ntag": [
                        "ndef_read"
                    ]
                }
            }
        }
    }
}
