    "devices": {
        "lcd": {
            "chip": "jd9165",
            "on": {"dsi.dsi0": {}},
            "pins": {"rst": 0, "backlight": {"gpio": 23, "active": "high"}},
            "config": {
                "primary": true,
                "panel": {"width": 1024, "height": 600, "mm_w": 154, "mm_h": 86},
                "depth_bits": 16
            },
            "controls": {"orientation": {"start": {"x": "left-right", "y": "top-bottom", "swap": false}}}
        },
        "touch": {
            "chip": "gt911",
            "on": {"i2c.i2c0": {}},
            "pins": {"rst": 22, "int": 21},
            "config": {
                "over": "lcd",
                "x_max": 1023,
                "y_max": 599,
                "calibrations": {
                    "esp-idf/jef-sure/dgx-di": [
                        {
                            "rule": "the newest",
                            "notes": "Measured before the versions were kept: measured_with is not known.",
                            "x_min": 0,
                            "x_max": 1023,
                            "y_min": 0,
                            "y_max": 599,
                            "width": 1024,
                            "height": 600,
                            "flags": 0,
                            "knots_x": 3,
                            "knots_y": 3,
                            "rounds": 3,
                            "affine": [66150, 221, -683737, 460, 66859, -1265431],
                            "x": [[48, 48], [512, 512], [975, 975]],
                            "y": [[49, 48], [298, 300], [552, 551]],
                            "down_ms": 0,
                            "up_ms": 60,
                            "blink_ms": 0,
                            "gap_ms": 0,
                            "off_tenths": 101,
                            "worst_tenths": 210,
                            "left_tenths": 33,
                            "left_worst_tenths": 70
                        }
                    ]
                }
            }
        },
        "sound": {
            "chip": "es8311",
            "on": {"i2c.i2c0": {}, "i2s.i2s0": {}},
            "pins": {"pa": 11},
            "config": {"sample_rate": 22050, "pa_voltage": 5.0, "codec_dac_voltage": 3.3},
            "controls": {"volume": {"start": 25}},
            "notes": [
                "MIC1 is fitted: ASDOUT of the codec comes in on GPIO48. Only the output is set up.",
                "CN1 takes a speaker: none is fitted on the board seen."
            ]
        },
        "boot": {"class": "button", "pins": {"in": {"gpio": 35, "active": "low"}}},
        "ethernet": {
            "class": "network",
            "on": {"rmii.rmii0": {}},
            "pins": {"rst": 51},
            "config": {"ref_clk": "from the PHY"},
            "controls": {"enabled": {"how": "driver", "values": ["off", "on"], "start": "off", "read": "none"}},
            "notes": [
                "U4 has the logo of IC Plus; the part number is not read and the schematic has none. 25 MHz crystal; its 50 MHz output feeds RMII_CLK. The LAN transformer is a JXD B1603S.",
                "TXD1 is GPIO35, the line of the BOOT button: a program that starts Ethernet loses the button."
            ]
        },
        "rs485": {
            "class": "network",
            "on": {"uart.uart1": {}},
            "config": {"transceiver": "MAX485", "direction": "auto"},
            "notes": "Q3 and a 74LVC1G132 make the direction from TX: no GPIO sets it. U8, the TVS diodes and the fuses are fitted on the board seen; the marking of U8 is not read. J5 brings IO26 and IO27 out beside it."
        },
        "rtc": {
            "chip": "rx8025t",
            "on": {"i2c.i2c0": {}},
            "notes": "BT1 has room for a CR1220 backup cell; none is fitted."
        },
        "sd": {
            "class": "storage",
            "on": {"sdmmc.sdmmc0": {}},
            "config": {"media": "microsd"},
            "notes": "Fed by LDO channel 4 of the chip, through Q1."
        },
        "radio": {
            "class": "radio",
            "on": {"sdio.sdio0": {}},
            "antenna": {"kind": "connector"},
            "config": {"chip": "esp32-c6"},
            "notes": "The ESP32-C6 inside the module: Wi-Fi and BLE of the P4, its antenna on a wire from a connector of the module."
        },
        "battery": {
            "class": "battery_adc",
            "pins": {"in": 53},
            "config": {"divider": "68k/100k"},
            "notes": "R55 is 0R on the schematic. The charger is an IP5306, with no line to the chip."
        }
